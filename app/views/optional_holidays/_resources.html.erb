<% @optional_holidays.each do |optional_holiday| %>
  <% makeup_date = current_unity ? optional_holiday.make_up_date_for(current_unity.id) : optional_holiday.make_up_date %>
  <% pending = current_unity ? optional_holiday.pending_make_up_for?(current_unity.id) : optional_holiday.pending_make_up? %>
  <tr>
    <td class="text-center">
      <% if pending %>
        <i class="fa fa-exclamation-triangle text-warning"
           title="<%= t('views.optional_holidays.index.make_up_date_pending') %>"
           aria-label="<%= t('views.optional_holidays.index.make_up_date_pending') %>"></i>
      <% end %>
    </td>
    <td><%= l(optional_holiday.holiday_date) %></td>
    <td><%= truncate(optional_holiday.description, length: 50) %></td>
    <td>
      <%= optional_holiday.effective_periods.map { |period| Periods.translate(Periods.key_for(period.to_s)) }.join(', ') %>
    </td>
    <td><%= optional_holiday.makeup_scope_humanize %></td>
    <td><%= makeup_date.present? ? l(makeup_date) : '-' %></td>
    <td class="actions">
      <%= link_to 'Visualizar', optional_holiday_path(optional_holiday), class: 'btn btn-info btn-sm' %>
      <% if administrator? || optional_holiday.makeup_scope_by_school? %>
        <%= link_to 'Editar', edit_optional_holiday_path(optional_holiday), class: 'btn btn-primary btn-sm' %>
      <% end %>
      <% if administrator? %>
        <%= link_to 'Excluir', optional_holiday_path(optional_holiday), method: :delete, class: 'btn btn-danger btn-sm',
          data: { confirm: t('views.optional_holidays.destroy_confirm') } %>
      <% end %>
    </td>
  </tr>
<% end %>
<% if @optional_holidays.empty? %>
  <tr>
    <td colspan="7"><%= t('views.optional_holidays.index.no_records') %></td>
  </tr>
<% end %>
