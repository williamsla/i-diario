<div class="widget-body no-padding">
  <%= aee_workflow_nav(:attendance) %>
  <%= simple_form_for :filter, { url: aee_attendance_records_path, method: :get, html: { class: 'filterable_search_form' } } do |f| %>
    <div class="table-responsive">
      <table id="resources" class="table table-bordered table-only-inner-bordered table-striped table-condensed table-hover">
        <thead>
          <tr>
            <td>
              <%= f.input :by_student_id, as: :select2, elements: @students, label: false,
                          placeholder: t('.by_student') %>
            </td>
            <td></td>
            <td></td>
            <td width="215px">
              <%= link_to t('.new_html'), new_aee_attendance_record_path, class: 'btn btn-primary pull-right' %>
            </td>
          </tr>
          <tr>
            <th><%= AeeAttendanceRecord.human_attribute_name :student %></th>
            <th><%= AeeAttendanceRecord.human_attribute_name :record_date %></th>
            <th><%= AeeAttendanceRecord.human_attribute_name :session_focus %></th>
            <th></th>
          </tr>
        </thead>

        <%= render 'resources' %>

        <tfoot id="paginator" class="remote">
          <td colspan="4">
            <div id="page_entries_info" class="pull-left hidden-xs">
              <%= page_entries_info @aee_attendance_records %>
            </div>
            <div class="pull-right">
              <%= paginate @aee_attendance_records %>
            </div>
          </td>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>
