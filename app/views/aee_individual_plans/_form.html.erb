<% content_for :js do %>
  <%= javascript_include_tag 'views/aee_individual_plans/form' %>
<% end %>

<% if @aee_individual_plan.regular? %>
  <% case_study = AeeCaseStudy.latest_for_aee(
    student: @aee_individual_plan.student,
    unity: @aee_individual_plan.unity,
    year: @aee_individual_plan.year
  ) %>
<% end %>

<%= simple_form_for @aee_individual_plan, html: { class: 'smart-form', id: 'aee_individual_plans_form' } do |f| %>
  <%= f.error_notification %>
  <input type="hidden" id="aee_individual_plan_id" value="<%= f.object.id if f.object.persisted? %>">
  <%= f.hidden_field :aee_case_study_id %>
  <%= aee_prefill_notice %>

  <% if @readonly %>
    <div class="alert alert-info">
      <%= t('.readonly_notice', context: f.object.context_label) %>
    </div>
  <% end %>

  <fieldset <%= 'disabled' if @readonly %>>
  <fieldset>
    <legend><%= t('.identification_legend') %></legend>

    <div class="row">
      <div class="col col-sm-6">
        <%= f.association :student, as: :select2, elements: @students, required: true,
                          readonly: f.object.persisted? %>
      </div>
    </div>

    <p class="aee-pei-identification" id="aee-pei-identification">
      <span id="aee-pei-age-item" style="<%= 'display: none;' if f.object.age.blank? %>">
        <span class="aee-pei-identification-label"><%= AeeIndividualPlan.human_attribute_name(:age) %></span>
        <span id="aee_individual_plan_age"><%= f.object.age %></span>
      </span>
      <span id="aee-pei-birth-item" style="<%= 'display: none;' if f.object.birth_date_label.blank? %>">
        <span class="aee-pei-identification-label"><%= AeeIndividualPlan.human_attribute_name(:birth_date_label) %></span>
        <span id="aee_individual_plan_birth_date_label"><%= f.object.birth_date_label %></span>
      </span>
      <span>
        <span class="aee-pei-identification-label"><%= AeeIndividualPlan.human_attribute_name(:origin) %></span>
        <%= f.object.origin_humanize %>
      </span>
      <span>
        <span class="aee-pei-identification-label"><%= AeeIndividualPlan.human_attribute_name(:classroom) %></span>
        <%= f.object.classroom %>
      </span>
    </p>

    <div class="row">
      <div class="col col-sm-4">
        <%= f.input :start_on, as: :date %>
      </div>
      <div class="col col-sm-4">
        <%= f.input :review_on, as: :date %>
      </div>
      <div class="col col-sm-4">
        <%= f.input :document_date, as: :date %>
      </div>
    </div>

    <% if f.object.regular? %>
      <div class="row" id="aee-case-study-action" style="<%= 'display: none;' unless case_study %>">
        <div class="col col-sm-12" style="margin-bottom: 10px;">
          <a href="#" class="btn btn-info" id="view-aee-case-study" data-toggle="modal" data-target="#aee-case-study-modal">
            <%= t('.view_case_study') %>
          </a>
        </div>
      </div>
      <div class="row">
        <div class="col col-sm-12">
          <% if @readonly %>
            <%= f.input :discipline_ids, as: :string, disabled: true, required: false,
                        label: AeeIndividualPlan.human_attribute_name(:disciplines),
                        input_html: { value: f.object.disciplines.map(&:to_s).join(', ') } %>
          <% else %>
            <%= f.association :disciplines, as: :select2, multiple: true, required: true,
                              elements: linked_disciplines_for_form(f.object),
                              hint: t('.disciplines_hint'),
                              input_html: {
                                value: f.object.discipline_ids.join(','),
                                data: { without_json_parser: true }
                              } %>
          <% end %>
        </div>
      </div>
    <% end %>
  </fieldset>

  <details class="aee-legal">
    <summary><%= t('aee.workflow.legal_summary') %></summary>
    <p><strong><%= t('.objective_title') %></strong> <%= t('.objective_text') %></p>
    <p><%= t('.legal_text') %></p>
  </details>

  <fieldset>
    <legend><%= t('.characteristics_legend') %></legend>
    <div class="row">
      <div class="col col-sm-12">
        <%= f.input :characteristics, as: :text,
              hint: t('.characteristics_hint'),
              input_html: { rows: 4 } %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>
      <%= t('.skills_legend') %>
      <span class="aee-section-hint"><%= t('.skills_hint') %></span>
    </legend>

    <div class="row">
      <div class="col col-sm-6">
        <%= f.input :psychomotor_skills, as: :text, input_html: { rows: 3 } %>
      </div>
      <div class="col col-sm-6">
        <%= f.input :cognitive_skills, as: :text, input_html: { rows: 3 } %>
      </div>
    </div>

    <div class="row">
      <div class="col col-sm-6">
        <%= f.input :socioemotional_skills, as: :text, input_html: { rows: 3 } %>
      </div>
      <div class="col col-sm-6">
        <%= f.input :linguistic_skills, as: :text, input_html: { rows: 3 } %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t('.difficulties_legend') %></legend>
    <div class="row">
      <div class="col col-sm-12">
        <%= f.input :identified_difficulties, as: :text,
              hint: t('.difficulties_hint'),
              input_html: { rows: 4 } %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t('.goals_legend') %></legend>
    <div class="row">
      <div class="col col-sm-12">
        <%= f.input :goals, as: :text,
              hint: t('.goals_hint'),
              input_html: { rows: 4 } %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t('.resources_legend') %></legend>
    <div class="row">
      <div class="col col-sm-6">
        <%= f.input :resources, as: :text,
              hint: t('.resources_hint'),
              input_html: { rows: 4 } %>
      </div>
      <div class="col col-sm-6">
        <%= f.input :strategies, as: :text, input_html: { rows: 4 } %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t('.monitoring_legend') %></legend>
    <div class="row">
      <div class="col col-sm-12">
        <%= f.input :monitoring, as: :text,
              hint: t('.monitoring_hint'),
              input_html: { rows: 4 } %>
      </div>
    </div>

    <% if f.object.aee? %>
    <p class="help-block">
      <%= is_aee ? t('.attendance_records_hint') : t('.attendance_records_readonly_hint') %>
      <% if !@readonly && is_aee && f.object.persisted? && f.object.student_id.present? %>
        <%= link_to t('.new_attendance'),
              new_aee_attendance_record_path(student_id: f.object.student_id),
              class: 'btn btn-success btn-xs pull-right' %>
      <% end %>
    </p>

    <div class="table-responsive">
      <table class="table table-bordered table-striped table-condensed">
        <thead>
          <tr>
            <th><%= t('.attendance_record_date') %></th>
            <th><%= t('.attendance_record_area') %></th>
            <th><%= t('.attendance_record_text') %></th>
          </tr>
        </thead>
        <tbody>
          <% attendance_records = f.object.attendance_records %>
          <% if attendance_records.any? %>
            <% attendance_records.each do |record| %>
              <tr>
                <td>
                  <% if is_aee %>
                    <%= link_to l(record.record_date), edit_aee_attendance_record_path(record) %>
                  <% else %>
                    <%= l(record.record_date) %>
                  <% end %>
                </td>
                <td><%= record.session_focus.presence || '-' %></td>
                <td><%= truncate(record.activities_developed.to_s, length: 220) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="3"><%= t('.attendance_records_empty') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
  </fieldset>

  <fieldset>
    <legend><%= t('.term_goals_legend') %></legend>
    <div class="row">
      <div class="col col-sm-6">
        <%= f.input :short_term_goals, as: :text, input_html: { rows: 3 } %>
      </div>
      <div class="col col-sm-6">
        <%= f.input :long_term_goals, as: :text, input_html: { rows: 3 } %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t('.final_considerations_legend') %></legend>
    <div class="row">
      <div class="col col-sm-12">
        <%= f.input :final_considerations, as: :text, input_html: { rows: 4 } %>
      </div>
    </div>
    <details class="aee-legal">
      <summary><%= t('aee.workflow.legal_summary') %></summary>
      <p><%= t('.final_considerations_text') %></p>
    </details>
  </fieldset>
  </fieldset>

  <footer>
    <%= link_to t('views.form.back'), aee_individual_plans_path, class: 'btn btn-default' %>

    <% if f.object.persisted? %>
      <%= link_to t('helpers.links.print_html'), aee_individual_plan_path(f.object),
                  class: 'btn btn-info', target: '_blank' %>
      <%= link_to t('views.form.history'), history_aee_individual_plan_path(f.object), class: 'btn btn-info' %>
      <%= aee_next_step_button(:pei, f.object.student) %>
    <% end %>

    <% unless @readonly %>
      <%= f.submit t('views.form.save'), class: 'btn btn-primary', data: { disable_with: 'Salvando...' } %>
    <% end %>
  </footer>
<% end %>

<% if @aee_individual_plan.regular? %>
  <%= render 'case_study_modal', case_study: case_study %>
<% end %>
