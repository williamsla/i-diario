  }
  .avaliation-batch-quantity-highlight {
    background: #fff7e6;
    border: 1px solid #f0d89a;
    border-left: 4px solid #e3b341;
    border-radius: 6px;
    padding: 10px 12px;
  }
  .avaliation-batch-quantity-highlight .label {
    color: #7a5a14;
    font-weight: 700;
  }
  .avaliation-batch-quantity-highlight .form-control {
