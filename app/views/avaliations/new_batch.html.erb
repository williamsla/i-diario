    background: #fffdfa;
    font-weight: 600;
  }
  .avaliation-batch-quantity-highlight .batch-assessments-select {
    width: 35%;
    min-width: 140px;
    margin-left: auto;
    text-align: center;
    text-align-last: center;
  }
  .avaliation-batch-quantity-highlight .batch-assessments-select option {
    text-align: center;
  }
</style>

<div class="widget-body no-padding">
  <% decimal_places = @batch.dig(:test_setting, :number_of_decimal_places).to_i %>
  <% decimal_places = 2 if decimal_places.negative? %>
  <div class="well well-sm">
    <p>
      <strong>Ano letivo:</strong> <%= @batch[:year] %>
      &nbsp;|&nbsp;
      <strong>Turma:</strong> <%= @batch[:classroom_label] %>
      &nbsp;|&nbsp;
      <strong><%= Avaliation.human_attribute_name(:step) %>:</strong> <%= @batch[:step_label] %>
    </p>
    <p style="margin-bottom: 0;">
      <strong>Disciplina:</strong> <%= @batch[:discipline_label] %>
    </p>
  </div>

  <% show_batch_config_panel = @batch[:show_calculation_type_select] || %w[arithmetic weighted_sum].include?(@batch[:mode].to_s) %>
  <% if show_batch_config_panel %>
  <div class="avaliation-batch-config">
    <%= form_tag new_batch_avaliations_path, method: :get, class: 'smart-form', id: 'avaliation_batch_config_form' do %>
      <%= hidden_field_tag :step_id, @batch[:step_id] %>

      <div class="row">
        <% if @batch[:show_calculation_type_select] %>
          <div class="col col-sm-6">
            <div class="form-group" style="margin-bottom: 0;">
              <div class="avaliation-batch-inline-field">
                <label class="label"><%= t('avaliations.batch.calculation_type_label') %></label>
                <%= select_tag :batch_calculation,
                      options_for_select(
                        [
                          [t('enumerations.average_calculation_types.arithmetic'), 'arithmetic'],
                          [t('avaliations.batch.sum_with_weights_label'), 'sum']
                        ],
                        @batch[:teacher_calculation]
                      ),
                      class: 'form-control',
                      onchange: 'this.form.submit()' %>
              </div>
            </div>
          </div>
        <% end %>

        <% if %w[arithmetic weighted_sum].include?(@batch[:mode].to_s) %>
          <% col_class = @batch[:show_calculation_type_select] ? 'col col-sm-6' : 'col col-sm-12' %>
          <div class="<%= col_class %>">
            <div class="form-group avaliation-batch-quantity-highlight" style="margin-bottom: 0;">
              <div class="avaliation-batch-inline-field">
                <label class="label"><%= t('avaliations.batch.assessments_label') %></label>
                <%= select_tag :assessments_count,
                      options_for_select((1..AvaliationBatchGrades::BuildContext::MAX_ARITHMETIC_COLUMNS).map { |i| [i, i] }, @batch[:columns].size),
                      class: 'form-control batch-assessments-select',
                      data: { min: @batch[:minimum_assessments_count] },
                      onchange: 'this.form.submit()' %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <% end %>

  <%= form_tag create_batch_avaliations_path, method: :post, class: 'smart-form' do %>
    <%= hidden_field_tag 'avaliation_batch[step_id]', @batch[:step_id] %>
    <%= hidden_field_tag 'avaliation_batch[batch_calculation]', @batch[:teacher_calculation] %>
    <% if %w[arithmetic weighted_sum].include?(@batch[:mode].to_s) %>
      <%= hidden_field_tag 'avaliation_batch[assessments_count]', @batch[:columns].size %>
    <% end %>
    <span id="batch-max-score-meta" class="hidden" data-max="<%= @batch[:selected_max_score] %>" data-decimals="<%= decimal_places %>"></span>

    <% if @batch[:weighted_sum_mode] %>
      <% wsum_init = @batch[:columns].sum { |c| c[:weight].to_f } %>
      <% max_init = @batch[:selected_max_score].to_f %>
    <% end %>

    <div class="table-responsive" style="margin: 0 12px;">
      <table class="table table-bordered table-only-inner-bordered table-striped avaliation-batch-grades-table">
        <thead>
          <tr>
            <th class="avaliation-batch-th-head"><%= t('avaliations.batch.student_column') %></th>
            <% @batch[:columns].each do |col| %>
              <th class="avaliation-batch-th-head <%= 'avaliation-batch-th-head-with-actions' if col[:avaliation_id].present? %>">
                <% if col[:editable_label] %>
                  <%= text_field_tag 'avaliation_batch[column_labels][]',
                        col[:label],
                        class: 'form-control input-sm avaliation-batch-editable-label',
                        autocomplete: 'off' %>
                <% else %>
                  <span class="avaliation-batch-col-label"><%= col[:label] %></span>
                  <%= hidden_field_tag 'avaliation_batch[column_labels][]', col[:label] %>
                <% end %>
                <% if col[:avaliation_id].present? %>
                  <%= link_to avaliation_path(col[:avaliation_id], step_id: @batch[:step_id]),
                        method: :delete,
                        class: 'avaliation-batch-delete-btn',
                        title: t('avaliations.batch.destroy_column_title'),
                        data: { confirm: t('avaliations.batch.confirm_destroy_column') } do %>
                    <span class="avaliation-batch-delete-x" aria-hidden="true">×</span>
                  <% end %>
                <% end %>
              </th>
            <% end %>
            <th class="avaliation-batch-th-head">
              <% if @batch[:weighted_sum_mode] %>
                <%= t('avaliations.batch.average_column') %> (0-10)
              <% else %>
                <%= t('avaliations.batch.average_column') %>
              <% end %>
            </th>
          </tr>
          <% if @batch[:weighted_sum_mode] %>
            <tr class="batch-col-weight-row">
              <th class="avaliation-batch-th-sub batch-weights-sum-cell">
                <%= t('avaliations.batch.weights_sum_label') %>:
                <span id="batch-weights-sum-readout"><%= number_with_precision(wsum_init, precision: decimal_places, separator: ',') %></span>
              </th>
              <% @batch[:columns].each do |col| %>
                <th class="avaliation-batch-th-sub" style="font-weight: normal; font-size: 12px;">
                  <div class="batch-col-weight-inline">
                    <label class="batch-col-weight-label"><%= t('avaliations.batch.weight_field_label') %></label>
                    <%= text_field_tag 'avaliation_batch[column_weights][]',
                          number_with_precision(col[:weight], precision: decimal_places, separator: ','),
                          class: 'form-control input-sm batch-col-weight',
                          data: { inputmask: "'digits': #{decimal_places}" },
                          autocomplete: 'off' %>
                  </div>
                </th>
              <% end %>
              <th class="avaliation-batch-th-sub"></th>
            </tr>
          <% end %>
        </thead>
        <tbody>
          <% @batch[:students].each do |student| %>
            <tr>
              <td class="batch-student-name"><%= student[:name] %></td>
              <% student[:notes].each_with_index do |note, idx| %>
                <td class="batch-note-cell">
                  <%= text_field_tag "avaliation_batch[notes][#{student[:id]}][]",
                        note.present? ? number_with_precision(note, precision: decimal_places, separator: ',') : '',
                        class: 'form-control input-sm batch-note-input',
                        data: { inputmask: "'digits': #{decimal_places}" },
                        autocomplete: 'off' %>
                </td>
              <% end %>
              <td class="batch-average-cell">
                <% if @batch[:weighted_sum_mode] %>
                  <span class="batch-average-value"><%= student[:normalized_average].present? ? number_with_precision(student[:normalized_average], precision: 2, separator: ',') : '—' %></span>
                <% else %>
                  <span class="batch-average-value"><%= student[:average].present? ? number_with_precision(student[:average], precision: 2, separator: ',') : '—' %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <footer style="padding: 12px 16px; border-top: 1px solid #eee; background: #fafafa;">
      <div class="clearfix">
        <div class="pull-left">
          <%= link_to t('avaliations.by_step.back_to_list'), avaliations_path, class: 'btn btn-default' %>
        </div>
        <div class="pull-right">
          <%= submit_tag t('avaliations.batch.save'), class: 'btn btn-primary', data: { disable_with: 'Salvando...' } %>
        </div>
      </div>
    </footer>
  <% end %>
</div>
