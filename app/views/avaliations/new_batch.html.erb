<% if @batch[:weighted_sum_mode] %>
  <% content_for :js do %>
    <script>
      (function () {
        function parseBr(s) {
          if (s === undefined || s === null || s === '') return 0;
          var str = String(s).trim();
          if (str.indexOf(',') >= 0 && str.indexOf('.') >= 0) str = str.replace(/\./g, '');
          return parseFloat(str.replace(',', '.')) || 0;
        }
        function updateBatchWeightsUi() {
          var meta = document.getElementById('batch-max-score-meta');
          if (!meta) return;
          var max = parseFloat(meta.getAttribute('data-max')) || 10;
          var decimals = parseInt(meta.getAttribute('data-decimals'), 10);
          if (isNaN(decimals) || decimals < 0) decimals = 2;
          var inputs = document.querySelectorAll('input.batch-col-weight');
          var sum = 0;
          for (var i = 0; i < inputs.length; i++) sum += parseBr(inputs[i].value);
          var pct = max > 0 ? Math.min(100, (sum / max) * 100) : 0;
          var bar = document.getElementById('batch-weights-progress-bar');
          if (bar) {
            bar.style.width = pct + '%';
            bar.className = 'progress-bar ' + (Math.abs(sum - max) < 0.02 ? 'progress-bar-success' : 'progress-bar-warning');
          }
          var sumEl = document.getElementById('batch-weights-sum-readout');
          if (sumEl) sumEl.textContent = sum.toFixed(decimals).replace('.', ',');
          var warn = document.getElementById('batch-weights-adjust-warning');
          if (warn) warn.style.display = Math.abs(sum - max) < 0.02 ? 'none' : 'inline';
        }
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('input.batch-col-weight').forEach(function (el) {
            el.addEventListener('input', updateBatchWeightsUi);
            el.addEventListener('change', updateBatchWeightsUi);
          });
          updateBatchWeightsUi();

          var table = document.querySelector('.avaliation-batch-grades-table');
          if (!table) return;

          table.addEventListener('keydown', function (evt) {
            if (evt.key !== 'Enter') return;
            var current = evt.target;
            if (!current || current.tagName !== 'INPUT') return;

            evt.preventDefault();

            var cell = current.closest('th, td');
            var row = current.closest('tr');
            if (!cell || !row) return;

            var cellIndex = cell.cellIndex;
            var section = row.parentElement; // thead/tbody
            var nextRow = row.nextElementSibling;

            function focusInputAt(targetRow, index) {
              if (!targetRow) return false;
              var targetCell = targetRow.cells[index];
              if (!targetCell) return false;
              var targetInput = targetCell.querySelector('input:not([type=\"hidden\"])');
              if (!targetInput) return false;
              targetInput.focus();
              targetInput.select && targetInput.select();
              return true;
            }

            if (focusInputAt(nextRow, cellIndex)) return;

            // Se estiver no thead sem próxima linha, tenta cair para a primeira linha de alunos.
            if (section && section.tagName === 'THEAD') {
              var firstBodyRow = table.querySelector('tbody tr');
              focusInputAt(firstBodyRow, cellIndex);
            }
          });
        });
      })();
    </script>
  <% end %>
<% end %>

<style>
  .avaliation-batch-grades-table thead th.avaliation-batch-th-head {
    vertical-align: middle;
    padding: 14px 12px;
    line-height: 1.4;
  }
  .avaliation-batch-grades-table thead th.avaliation-batch-th-sub {
    padding: 10px 12px;
    vertical-align: middle;
  }
  .avaliation-batch-th-head-with-actions {
    position: relative;
    padding-top: 18px !important;
  }
  .avaliation-batch-delete-btn {
    color: #b30000;
    border: none;
    background: transparent;
    box-shadow: none;
    padding: 0 4px;
    font-weight: 700;
    text-decoration: none;
    position: absolute;
    top: -8px;
    right: -8px;
    z-index: 2;
  }
  .avaliation-batch-delete-btn:hover,
  .avaliation-batch-delete-btn:focus {
    color: #7d0000;
    background: transparent;
    text-decoration: none;
  }
  .avaliation-batch-delete-btn .avaliation-batch-delete-x {
    font-size: 28px;
    line-height: 1;
    width: 1em;
    text-align: center;
    display: inline-block;
  }
  .avaliation-batch-editable-label {
    min-width: 140px;
    width: 100%;
    margin-bottom: 0;
    height: 30px;
    font-weight: 600;
  }
  .avaliation-batch-col-label {
    vertical-align: middle;
  }
  .avaliation-batch-grades-table th,
  .avaliation-batch-grades-table td {
    padding-left: 10px;
    padding-right: 10px;
    vertical-align: middle;
  }
  .avaliation-batch-grades-table th:first-child,
  .avaliation-batch-grades-table td:first-child {
    min-width: 230px;
  }
  .avaliation-batch-grades-table .batch-student-name {
    white-space: normal !important;
    word-break: break-word !important;
    overflow-wrap: anywhere;
    line-height: 1.25;
    display: block;
    width: 100%;
  }
  .avaliation-batch-grades-table .batch-note-cell {
    width: 120px;
    min-width: 120px;
    max-width: 120px;
    text-align: center;
  }
  .avaliation-batch-grades-table .batch-average-cell {
    width: 110px;
    min-width: 110px;
    max-width: 110px;
    text-align: center;
  }
  .avaliation-batch-grades-table .batch-note-input,
  .avaliation-batch-grades-table .batch-average-value {
    text-align: center;
  }
  @media (max-width: 767px) {
    .avaliation-batch-grades-table th:first-child,
    .avaliation-batch-grades-table td:first-child {
      min-width: 115px;
      max-width: 115px;
      width: 115px;
      white-space: normal !important;
    }
  }
  .avaliation-batch-grades-table .form-control {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  .avaliation-batch-grades-table .batch-col-weight-row th {
    background: #fff5db;
    border-top: 2px solid #f1d28a;
  }
  .avaliation-batch-grades-table .batch-weights-sum-cell {
    text-align: right;
    white-space: nowrap;
    color: #7a5a14;
    font-weight: 700;
  }
  .avaliation-batch-grades-table .batch-col-weight-label {
    display: inline-block;
    margin-bottom: 0;
    margin-right: 8px;
    padding: 2px 8px;
    border-radius: 10px;
    background: #f7e5b8;
    color: #7a5a14;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .avaliation-batch-grades-table .batch-col-weight {
    border: 2px solid #e0b95f;
    background: #fffaf0;
    font-weight: 700;
  }
  .avaliation-batch-grades-table .batch-col-weight:focus {
    border-color: #c8921f;
    box-shadow: 0 0 0 2px rgba(200, 146, 31, 0.15);
    background: #fffdf7;
  }
  .batch-col-weight-inline {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .batch-col-weight-inline .batch-col-weight {
    flex: 1;
    min-width: 72px;
  }
  .avaliation-batch-config .row {
    display: grid;
    grid-template-columns: minmax(0, 620px);
    justify-content: center;
    gap: 10px;
    margin-left: 0;
    margin-right: 0;
  }
  .avaliation-batch-config .row > [class*='col-'] {
    float: none;
    width: auto;
    padding-left: 0;
    padding-right: 0;
  }
  .avaliation-batch-inline-field {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .avaliation-batch-inline-field .label {
