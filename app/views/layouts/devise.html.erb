<!DOCTYPE html>
<html lang="pt-br" id="extr-page" class="login-screen">
  <head>
    <%= render 'layouts/google_tag_manager_head' %>
    <%= render 'layouts/default_headers', title: 'Diário Escolar' %>
  </head>

  <body class="login-screen">
    <%= render 'layouts/google_tag_manager_body' %>
    <header id="header" class="login-topbar">
      <%= link_to root_path, class: "login-brand" do %>
        <%= image_tag logo_url, alt: current_entity_configuration.try(:entity_name), class: "login-brand-mark" %>
        <span><%= current_entity_configuration.try(:entity_name).presence || "i-Diário" %></span>
      <% end %>
      <span id="extr-page-header-space">
        <span class="hidden-mobile">Primeiro acesso?</span>
        <%= link_to "Criar conta", new_registration_path, class: "btn btn-danger" %>
      </span>
    </header>

    <div id="main" role="main">
      <div id="content" class="login-shell">
        <div class="login-layout">
          <div class="login-panel">
            <% if Date.current.month == 10 %>
              <a class="login-campaign" href="https://www.google.com.br/#q=outubro+rosa+<%= Date.current.year %>" target="_blank" rel="noopener noreferrer">
                <%= image_tag 'outubro_rosa.svg', alt: 'Outubro Rosa', class: 'custom-login-image' %>
              </a>
            <% elsif Date.current.month == 11 %>
              <a class="login-campaign" href="https://www.google.com.br/#q=novembro+azul+<%= Date.current.year %>" target="_blank" rel="noopener noreferrer">
                <%= image_tag 'novembro-azul.jpg', alt: 'Novembro Azul', class: 'custom-login-image' %>
              </a>
            <% end %>

            <h1>Diário Escolar Online</h1>
            <p class="login-lead">
              Acesso para professores, coordenação pedagógica e busca ativa.
            </p>

            <%= bootstrap_flash %>
            <%= yield %>

            <div class="login-support">
              <p>Dúvidas sobre acesso, senha ou cadastro?</p>
              <a class="login-whatsapp" href="<%= support_whatsapp_url('Olá, preciso de ajuda para acessar o Diário Escolar.') %>" target="_blank" rel="noopener noreferrer">
                <i class="fa fa-whatsapp" aria-hidden="true"></i>
                Falar com o suporte no WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <footer class="login-footer">
      Por <%= link_to "Educa Online Tecnologia", "https://educaonline.tec.br", target: "_blank", rel: "noopener noreferrer" %>
    </footer>

    <%= javascript_include_tag "devise" %>
  </body>
</html>
