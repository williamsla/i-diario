<% content_for :js do %>
  <%= javascript_include_tag 'views/layouts/role_bar' %>
  <% if params[:modal] != 'true' %>
    <% support_number = ENV['SUPPORT_NUMBER'].present? ? ENV['SUPPORT_NUMBER'] : '558281670619' %>
    <script type="text/javascript">
      document.addEventListener('DOMContentLoaded', function() {
        // Encontra a lista de navegação
        const navList = document.querySelector('#left-panel nav ul');
        
        if (navList) {
          // Cria o botão do WhatsApp
          const whatsappButton = document.createElement('li');
          whatsappButton.className = 'whatsapp-sidebar-item';
          whatsappButton.innerHTML = '<a href="https://wa.me/<%= support_number %>" target="_blank" class="whatsapp-sidebar-button" title="Fale conosco no WhatsApp"><i class="fa fa-whatsapp"></i> <span class="menu-item-parent">Tire suas dúvidas</span></a>';
          
          // Adiciona no final da lista
          navList.appendChild(whatsappButton);
        }
      });
    </script>
  <% end %>
<% end %>

<aside id="left-panel">
  <nav>
    <%= menus %>
  </nav>
</aside>

<%= hidden_field :current_action_, '', value: controller.action_name %>
