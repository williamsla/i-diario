<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <%= render 'layouts/datalayer' %>
    <%= render 'layouts/google_tag_manager_head' %>
    <%= render 'layouts/default_headers', title: title %>
    <link rel="stylesheet" href="https://unpkg.com/vue-multiselect@2.1.0/dist/vue-multiselect.min.css">
  </head>

  <body class="smart-style-2 fixed-header <%= controller_name %>">
    <%= render 'layouts/google_tag_manager_body' %>

    <div id="page-loading" class="hidden">
      <i class="fa fa-cog fa-spin"></i>
      Carregando ...
    </div>

    <header id="header" style="height: 77px; background-color: #27333B;">
      <div id="logo-group" style="margin-top: 10px; margin-left: 10px;">
        <%= link_to image_tag(
            logo_url,
            height: '57px',
            alt: current_entity_configuration.try(:entity_name),
            style: 'background-color: white; border-radius: 3px;'
          ), root_path %>
      </div>

      <%= render "layouts/profile_selection" %>

      <div class="pull-right" style="margin-top: 15px;">
        <% if user_signed_in? %>
          <div id="hide-menu" class="btn-header pull-right">
            <span>
              <a href="javascript:void(0);" data-action="toggleMenu" title="Exibir/Esconder o Menu">
                <i class="fa fa-reorder"></i>
              </a>
            </span>
          </div>
          <%= render 'layouts/system_notifications' %>
        <% end %>
      </div>
    </header>

    <%= render 'layouts/navigation' %>

    <div id="main" role="main">
      <div id="ribbon" style="padding-left: 15px; padding-top: 15px;">
        <%= breadcrumbs %>
      </div>

      <%= yield :back_link %>

      <div id="content">
        <div id="flash-messages">
          <%= bootstrap_flash %>
        </div>

        <section id="widget-grid" class="">
          <div class="row">
            <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
              <div class="jarviswidget">
                <header>
                  <h2><%= title_with_icon %></h2>
                  <%= yield(:help_button_tag) if content_for?(:help_button_tag) %>
                </header>

                <div id="content-page" role="content">
                  <%= yield %>
                </div>
              </div>
            </article>
          </div>
        </section>
      </div>
    </div>

    <div class="page-footer">
      <div class="row">
        <div class="col-xs-12 col-sm-6">
          <span class="txt-color-white"><%= entity_copyright %></span>
        </div>
      </div>
    </div>

    <script type="text/javascript">
      <% if current_user %>
         window.state = <%= raw window_state.to_json %>;
      <% end %>
    </script>

    <script>
      <% unless current_user&.current_discipline_id.presence %>
          # alert('TODO: Selecione uma disciplina para continuar.');
      <% end %>
    </script>

    
    <%# esconde botões baseado na turma do professor %>
    <script type="text/javascript">
      document.addEventListener('DOMContentLoaded', function() { 

        <% year = current_user.current_school_year || Time.current.year %>  
        <% if year >= 2025 %>  
         
              // Se for série educação infantil ou AEE
              <% if is_infantil == true %>
                  
                  // Se começou como disciplina ou área de conhecimento                  
                  // TODO: essa condição interna (if) é útil somente no ano 2025 em canindé.
                  <% if started_as_discipline == true && started_as_knowledge_area == true %>
                    
                    const hrefs_to_hide = [];

                  <% elsif started_as_discipline == true %>
                    
                    const hrefs_to_hide = [
                      '/planos-de-ensino-por-areas-de-conhecimento',
                      '/planos-de-aula-por-areas-de-conhecimento',
                      '/registros-de-conteudos-por-areas-de-conhecimento'
                    ];

                  <% else %>
                    
                    const hrefs_to_hide = [
                        '/planos-de-ensino-por-disciplina',
                        '/planos-de-aulas-por-disciplina',
                        '/registros-de-conteudos-por-disciplina',
                        '/relatorios/planos-de-aula-por-disciplina',
                    ];
                  <% end %>

                  <% if has_opinion == false %>
                    hrefs_to_hide.push('/avaliacoes-descritivas/novo',
                                        '/relatorios/descriptive');
                  <% end %>

                  <% if has_numeric_avaliation == false %>
                    hrefs_to_hide.push('/avaliacoes',
                                        '/diario-de-avaliacoes',
                                        '/diario-de-recuperacoes-de-etapas',
                                        '/diario-de-recuperacoes-finais',
                                        '/diario-de-recuperacoes-de-avaliacoes',
                                        '/diario-de-recuperacoes-de-avaliacoes-da-menor-nota',
                                        '/dispensa-de-avaliacoes',
                                        '/notas-de-transferencia',
                                        '/avaliacoes-complementares',
                                        '/diario-de-avaliacoes-complementares',
                                        '/relatorios/registro-de-avaliacoes',
                                        '/relatorios/boletim-do-professor',
                                        '/relatorios/registro-de-notas-parciais');
                  <% end %>

                  <% if has_concept_avaliation == false %>
                    hrefs_to_hide.push('/diario-de-avaliacoes-conceituais');
                  <% end %>

              <% else %>

                  // TODO: essa condição interna (if) é útil somente no ano 2025 em canindé.
                  <% if current_classroom_grades && started_as_knowledge_area == true %>
                    const hrefs_to_hide = []
                  <% else %>
                    const hrefs_to_hide = [
                      '/planos-de-ensino-por-areas-de-conhecimento',
                      '/planos-de-aula-por-areas-de-conhecimento',
                      '/registros-de-conteudos-por-areas-de-conhecimento'
                    ];
                  <% end %>

                  <% if has_opinion == false %>
                    hrefs_to_hide.push('/avaliacoes-descritivas/novo',
                                        '/relatorios/descriptive');
                  <% end %>

                  <% if has_numeric_avaliation == false %>
                    hrefs_to_hide.push('/avaliacoes',
                                        '/diario-de-avaliacoes',
                                        '/diario-de-recuperacoes-de-etapas',
                                        '/diario-de-recuperacoes-finais',
                                        '/diario-de-recuperacoes-de-avaliacoes',
                                        '/diario-de-recuperacoes-de-avaliacoes-da-menor-nota',
                                        '/dispensa-de-avaliacoes',
                                        '/notas-de-transferencia',
                                        '/avaliacoes-complementares',
                                        '/diario-de-avaliacoes-complementares',
                                        '/relatorios/registro-de-avaliacoes',
                                        '/relatorios/boletim-do-professor',
                                        '/relatorios/registro-de-notas-parciais');
                  <% end %>

                  <% if has_concept_avaliation == false %>
                    hrefs_to_hide.push('/diario-de-avaliacoes-conceituais');
                  <% end %>

              <% end %>

              hrefs_to_hide.forEach(href => {
                const links = document.querySelectorAll(`a[href="${href}"]`);
                links.forEach(link => {
                  const divAncestor = link.closest('div,li');
                  if (divAncestor) divAncestor.style.display = 'none';
                });
              }); //end forEach

        <% end %> //end if year

      }); //end DOMContentLoaded
    </script>
    
    <%= javascript_include_tag "application" %>
    <%= javascript_pack_tag 'app', defer: true %>
    <%= stylesheet_pack_tag 'app' %>

    <%= yield :js %>

    <% if ENV['SUPPORT_NUMBER'].present? && params[:modal] != 'true' %>
      <div class="whatsapp-button">
        <a href="https://wa.me/<%= ENV['SUPPORT_NUMBER'] %>" target="_blank">
          <img src="https://cdn-icons-png.flaticon.com/512/124/124034.png" alt="WhatsApp">
        </a>
      </div>
    <% end %>


    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('modal') === 'true') {
          document.body.classList.add('modal-mode');
        }
      });
    </script>


  </body>
</html>
