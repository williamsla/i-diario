<% content_for :js do %>
  <%= javascript_include_tag 'views/aee_case_studies/form' %>
<% end %>

<%= simple_form_for @aee_case_study, html: { class: 'smart-form aee-case-study-form', id: 'aee_case_studies_form' } do |f| %>
  <%= f.error_notification %>

  <fieldset class="aee-fieldset">
    <legend><%= t('.identification_legend') %></legend>

    <div class="row">
      <div class="col col-sm-8">
        <%= f.association :student, as: :select2, elements: @students, required: true,
                          readonly: f.object.persisted? %>
      </div>
      <div class="col col-sm-4">
        <%= f.input :document_date, as: :date %>
      </div>
    </div>

    <div class="aee-student-summary<%= ' is-empty' if f.object.student.blank? %>" id="aee-student-summary"
         data-empty="<%= t('.summary_empty') %>"
         <%= 'hidden'.html_safe if f.object.student.blank? %>>
      <div class="aee-student-summary-item">
        <span class="aee-student-summary-label"><%= AeeCaseStudy.human_attribute_name(:age) %></span>
        <strong class="aee-student-summary-value" data-summary="age"><%= f.object.age.presence || t('.summary_empty') %></strong>
      </div>
      <div class="aee-student-summary-item">
        <span class="aee-student-summary-label"><%= AeeCaseStudy.human_attribute_name(:grade_stage) %></span>
        <strong class="aee-student-summary-value" data-summary="grade_stage"><%= f.object.grade_stage.presence || t('.summary_empty') %></strong>
      </div>
      <div class="aee-student-summary-item">
        <span class="aee-student-summary-label"><%= AeeCaseStudy.human_attribute_name(:modality) %></span>
        <strong class="aee-student-summary-value" data-summary="modality"><%= f.object.modality.presence || t('.summary_empty') %></strong>
      </div>
    </div>

    <div class="row">
      <div class="col col-sm-12">
        <%= f.input :identification, as: :text,
              hint: t('.identification_field_hint'),
              input_html: { rows: 2 } %>
      </div>
    </div>
  </fieldset>

  <fieldset class="aee-fieldset">
    <legend><%= t('.stages_legend') %></legend>

    <div class="row">
      <div class="col col-sm-6">
        <%= render 'stage_field', f: f, attribute: :individual_demands, index: 'I',
              title: t('.stage_i_title'), hint: t('.individual_demands_hint') %>
      </div>
      <div class="col col-sm-6">
        <%= render 'stage_field', f: f, attribute: :barriers_and_context, index: 'II',
              title: t('.stage_ii_title'), hint: t('.barriers_and_context_hint') %>
      </div>
    </div>

    <div class="row">
      <div class="col col-sm-6">
        <%= render 'stage_field', f: f, attribute: :potentialities_and_support, index: 'III',
              title: t('.stage_iii_title'), hint: t('.potentialities_and_support_hint') %>
      </div>
      <div class="col col-sm-6">
        <%= render 'stage_field', f: f, attribute: :accessibility_strategies, index: 'IV',
              title: t('.stage_iv_title'), hint: t('.accessibility_strategies_hint') %>
      </div>
    </div>

    <div class="row">
      <div class="col col-sm-12">
        <%= f.input :final_considerations, as: :text,
              hint: t('.final_considerations_hint'),
              input_html: { rows: 3 } %>
      </div>
    </div>
  </fieldset>

  <details class="aee-legal">
    <summary><%= t('.legal_summary') %></summary>
    <p><%= t('.legal_text') %></p>
  </details>

  <footer>
    <%= link_to t('views.form.back'), aee_case_studies_path, class: 'btn btn-default' %>

    <% if f.object.persisted? %>
      <%= link_to t('helpers.links.print_html'), aee_case_study_path(f.object),
                  class: 'btn btn-info', target: '_blank' %>
      <%= link_to t('views.form.history'), history_aee_case_study_path(f.object), class: 'btn btn-info' %>
    <% end %>

    <%= f.submit t('views.form.save'), class: 'btn btn-primary', data: { disable_with: 'Salvando...' } %>
  </footer>
<% end %>
