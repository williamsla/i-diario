<% content_for :js do %>
  <%= javascript_include_tag 'views/descriptive_report/form' %>
<% end %>
<div class="widget-body no-padding">
  <%= simple_form_for @descriptive_report_form, url: descriptive_report_path, method: :post, html: { class: 'smart-form', target: '_blank' } do |f| %>
    <fieldset>
      <div class="row">
        <div class="col col-sm-4">
          <%= f.input :classroom_id, as: :select2_classroom, user: current_user %>
          <%= f.hidden_field :start_at %>
          <%= f.hidden_field :end_at %>
        </div>        
      </div>

    </fieldset>

    <footer>
      <%= f.submit 'Imprimir', class: 'btn btn-primary' %>
    </footer>
  <% end %>
</div>
