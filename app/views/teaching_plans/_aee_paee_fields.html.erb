<% if is_aee %>
  <% teaching_plan_form.object.build_aee_teaching_plan_detail if teaching_plan_form.object.aee_teaching_plan_detail.blank? %>
  <%= teaching_plan_form.simple_fields_for :aee_teaching_plan_detail do |detail| %>
    <%= aee_prefill_notice %>

    <fieldset>
      <legend><%= t('teaching_plans.aee_paee.organization_legend') %></legend>

      <div class="row">
        <div class="col col-sm-4">
          <%= detail.input :attendance_frequency, readonly: action_name.eql?('show') %>
        </div>
        <div class="col col-sm-4">
          <%= detail.input :attendance_duration, readonly: action_name.eql?('show') %>
        </div>
        <div class="col col-sm-4">
          <%= detail.input :attendance_composition, as: :select,
                collection: AeeAttendanceCompositions.to_a,
                label_method: :first,
                value_method: :last,
                include_blank: true,
                readonly: action_name.eql?('show') %>
        </div>
      </div>
    </fieldset>

    <details class="aee-legal">
      <summary><%= t('aee.workflow.legal_summary') %></summary>
      <p><%= t('teaching_plans.aee_paee.legal_text') %></p>
    </details>

    <fieldset>
      <legend><%= t('teaching_plans.aee_paee.objectives_legend') %></legend>

      <div class="row">
        <div class="col col-sm-12">
          <%= detail.input :student_characteristics, as: :text,
                hint: t('teaching_plans.aee_paee.characteristics_hint'),
                input_html: { rows: 4 },
                readonly: action_name.eql?('show') %>
        </div>
      </div>

      <div class="row">
        <div class="col col-sm-12">
          <%= detail.input :general_objectives, as: :text,
                hint: t('teaching_plans.aee_paee.general_objectives_hint'),
                input_html: { rows: 4 },
                readonly: action_name.eql?('show') %>
        </div>
      </div>

      <div class="row">
        <div class="col col-sm-4">
          <%= detail.input :cognitive_objectives, as: :text, input_html: { rows: 3 },
                readonly: action_name.eql?('show') %>
        </div>
        <div class="col col-sm-4">
          <%= detail.input :psychomotor_objectives, as: :text, input_html: { rows: 3 },
                readonly: action_name.eql?('show') %>
        </div>
        <div class="col col-sm-4">
          <%= detail.input :socioemotional_objectives, as: :text, input_html: { rows: 3 },
                readonly: action_name.eql?('show') %>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend><%= t('teaching_plans.aee_paee.activities_legend') %></legend>
      <div class="row">
        <div class="col col-sm-12">
          <%= detail.input :activities, as: :text,
                hint: t('teaching_plans.aee_paee.activities_hint'),
                input_html: { rows: 4 },
                readonly: action_name.eql?('show') %>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend><%= t('teaching_plans.aee_paee.strategies_legend') %></legend>
      <div class="row textarea">
        <div class="col col-sm-12">
          <%= teaching_plan_form.input :methodology, label: false,
                input_html: { class: 'col col-sm-12' },
                readonly: action_name.eql?('show') %>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend><%= t('teaching_plans.aee_paee.resources_legend') %></legend>
      <div class="row">
        <div class="col col-sm-12">
          <%= detail.input :resources, as: :text, label: false, input_html: { rows: 4 },
                readonly: action_name.eql?('show') %>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend><%= t('teaching_plans.aee_paee.evaluation_legend') %></legend>
      <div class="row textarea">
        <div class="col col-sm-12">
          <%= teaching_plan_form.input :evaluation, label: false,
                input_html: { class: 'col col-sm-12' },
                readonly: action_name.eql?('show') %>
        </div>
      </div>
    </fieldset>
  <% end %>
<% end %>
