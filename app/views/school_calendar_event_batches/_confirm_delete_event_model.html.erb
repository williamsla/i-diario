<div class="modal fade" tabindex="-1" role="dialog" id="modal-delete-school_calendar_event-<%=school_calendar_event.id%>" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <strong>
          <h4 class="modal-title" style='text-align:left'>
            <%= t('.title') %>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </h4>
        </strong>
      </div>
      <div class="modal-body" style='text-align:left'>
        <strong>
          <h5><%= t('.body') %></h5>
        </strong>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn new-school-calendar-event-cancel" data-dismiss="modal">
          <%= t('.cancel') %>
        </button>
        <%= link_to t('.keep_records'),
                    school_calendar_event_batch_path(school_calendar_event, keep_teacher_records: true),
                    class: 'btn btn-success',
                    method: :delete %>
        <%= link_to t('.remove_records'),
                    school_calendar_event_batch_path(school_calendar_event, keep_teacher_records: false),
                    class: 'btn btn-danger',
                    method: :delete %>
      </div>
    </div>
  </div>
</div>
