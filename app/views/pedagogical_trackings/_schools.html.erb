<section class="pedagogical-panel pedagogical-schools-panel">
  <header class="pedagogical-panel__header">
    <h2 class="pedagogical-panel__title"><%= t('pedagogical_trackings.index.schools_list') %></h2>
    <p class="pedagogical-panel__description"><%= t('pedagogical_trackings.index.schools_list_description') %></p>
  </header>

  <%= simple_form_for :filter, { url: pedagogical_trackings_path, method: :get, html: { class: 'percent_filterable_search_form' } } do |f| %>
    <%= hidden_field_tag 'start_date', @start_date %>
    <%= hidden_field_tag 'end_date', @end_date %>
    <%= hidden_field_tag 'step_start_date', @start_date && @start_date.strftime('%d/%m/%Y') %>
    <%= hidden_field_tag 'step_end_date', @end_date && @end_date.strftime('%d/%m/%Y') %>

    <div class="pedagogical-schools-panel__filters">
      <%= f.input :unity_id,
                  as: :select2,
                  elements: all_unities,
                  label: t('pedagogical_trackings.index.filter_unities'),
                  placeholder: t('pedagogical_trackings.index.filter_unities'),
                  wrapper_html: { class: 'pedagogical-schools-panel__filter' } %>
    </div>

    <div class="table-responsive">
      <table class="table table-bordered table-only-inner-bordered table-striped table-condensed table-hover pedagogical-schools-table" id="resources">
        <thead>
          <tr>
            <th class="pedagogical-schools-table__school-col" scope="col">
              <%= t('pedagogical_trackings.index.filter_unities') %>
            </th>
            <th class="pedagogical-schools-table__actions-col" scope="col">
              <%= t('pedagogical_trackings.index.action') %>
            </th>
          </tr>
        </thead>

        <%= render 'resources' %>

        <tfoot id="paginator" class="remote">
          <td colspan="2">
            <div id="page_entries_info" class="pull-left hidden-xs">
              <%= page_entries_info @percents %>
            </div>
            <div class="pull-right">
              <%= paginate @percents %>
            </div>
          </td>
        </tfoot>
      </table>
    </div>
  <% end %>
</section>

<%= render 'action_modals' %>
