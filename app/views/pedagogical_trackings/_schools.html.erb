<div class="widget-body" style="border: 1px solid;border-color: #CCC;padding: 10px;margin-bottom: 15px;">
  <%= simple_form_for :filter, { url: pedagogical_trackings_path, method: :get, html: { class: 'percent_filterable_search_form' } } do |f| %>
    <%= hidden_field_tag 'start_date', @start_date %>
    <%= hidden_field_tag 'end_date', @end_date %>
    <%= hidden_field_tag 'step_start_date', @start_date && @start_date.strftime('%d/%m/%Y') %>
    <%= hidden_field_tag 'step_end_date', @end_date && @end_date.strftime('%d/%m/%Y') %>
    <div class="table-responsive">
      <table class="table table-bordered table-only-inner-bordered table-striped table-condensed table-hover" id="resources">
        <thead>
          <tr>
            <td>
              <%= f.input :unity_id, as: :select2, elements: all_unities, label: false, placeholder: t('pedagogical_trackings.index.filter_unities') %>
            </td>

            <!--
            <td>
              <%= f.input :frequency_operator, as: :select2, elements: ComparativeOperators.to_select.to_json, label: false, placeholder: t('pedagogical_trackings.index.filter_frequency') %>
              <%= f.input :frequency_percentage, label: false, input_html: { type: 'number' } %>
            </td>
            <td>
              <%= f.input :content_record_operator, as: :select2, elements: ComparativeOperators.to_select.to_json, label: false, placeholder: t('pedagogical_trackings.index.filter_content_record') %>
              <%= f.input :content_record_percentage, label: false, input_html: { type: 'number' } %>
            </td>
            -->
            
            <td style="text-align: center;">
              <span>Ação</span>
            </td>
          </tr>
        </thead>

        <%= render 'resources'%>

        <tfoot id="paginator" class="remote">
          <td colspan="4">
            <div id="page_entries_info" class="pull-left hidden-xs">
              <%= page_entries_info @percents %>
            </div>
            <div class="pull-right">
              <%= paginate @percents %>
            </div>
          </td>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>

<div id="resumeModal" style="display:none; position:fixed; inset:0; background-color:rgba(0,0,0,0.7);
                             justify-content:center; align-items:center; z-index:9999;">
  <div style="background:white; padding:20px; border-radius:15px; max-height:95vh; overflow:auto; width:90%; box-shadow:0 5px 15px rgba(0,0,0,0.3);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
      <h2 style="margin:0; font-size:1.5em;">Resumo de Lançamentos</h2>
      <!-- Botão de baixar planilha -->
      
      <button id="downloadXlsxBtn" style="background-color:#1D72B8; color:white; padding:10px 15px; border-radius:8px; border:none; cursor:pointer;">Baixar planilha</button>
      <button onclick="closeResumeModal()" style="background:none; border:none; font-size:3.5em; cursor:pointer;">&times;</button>      
    </div>

    <div id="resumeModalBody" style="margin-bottom:15px;">
      <!-- Conteúdo da planilha será injetado aqui -->
    </div>

    <div style="display:flex; justify-content:flex-end; gap:10px;">
      <!-- Botão de fechar modal -->
      <button onclick="closeResumeModal()" style="background-color:#555; color:white; padding:10px 15px; border-radius:8px; border:none; cursor:pointer;">Fechar</button>
    </div>
  </div>
</div>

