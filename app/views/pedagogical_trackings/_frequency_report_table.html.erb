<style>
  .frequency-report-table {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  
  .frequency-report-table table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 30px;
    min-width: 800px;
  }
  
  .frequency-report-table th {
    padding: 10px 8px;
    border: 1px solid #ddd;
    background-color: #f5f5f5;
    font-weight: 600;
    white-space: nowrap;
    line-height: 1.4;
  }
  
  .frequency-report-table td {
    padding: 10px 8px;
    border: 1px solid #ddd;
  }
  
  .frequency-report-table th br {
    display: block;
    content: "";
    margin-top: 2px;
  }
  
  @media (max-width: 768px) {
    .frequency-report-table {
      font-size: 12px;
    }
    
    .frequency-report-table th,
    .frequency-report-table td {
      padding: 8px 4px;
      font-size: 11px;
    }
    
    .frequency-report-table th {
      font-size: 10px;
    }
  }
  
  @media (max-width: 480px) {
    .frequency-report-table {
      font-size: 11px;
    }
    
    .frequency-report-table th,
    .frequency-report-table td {
      padding: 6px 3px;
      font-size: 10px;
    }
  }
  
  .risk-filter {
    background-color: #f8f9fa;
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 8px;
    border: 1px solid #dee2e6;
  }
  
  .risk-filter label {
    margin-right: 20px;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  
  .risk-filter input[type="checkbox"] {
    cursor: pointer;
    width: 18px;
    height: 18px;
  }
  
  .risk-filter-title {
    font-weight: 600;
    margin-bottom: 10px;
    color: #495057;
  }

  .student-observations-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    padding: 0 6px;
    border-radius: 50%;
    font-weight: 600;
    line-height: 1;
    text-decoration: none !important;
  }

  a.student-observations-count {
    background-color: #1D72B8;
    color: #fff !important;
    box-shadow: 0 1px 2px rgba(29, 114, 184, 0.35);
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  a.student-observations-count:hover,
  a.student-observations-count:focus {
    background-color: #155a94;
    color: #fff !important;
    transform: scale(1.08);
  }

  span.student-observations-count {
    color: #6c757d;
    background: transparent;
  }

  .student-observations-cell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    white-space: nowrap;
  }

  .student-observations-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid #ced4da;
    border-radius: 50%;
    background: #fff;
    color: #495057;
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .student-observations-add:hover,
  .student-observations-add:focus {
    background-color: #1D72B8;
    border-color: #1D72B8;
    color: #fff;
  }
</style>

<div class="frequency-report-table">
  <!-- Filtros -->
  <div class="risk-filter">
    <form id="riskClassificationFilter">
      <div style="margin-bottom: 15px;">
        <strong>Critério de Alerta:</strong>
        <label style="display: block; margin: 8px 0;">
          <input type="radio" name="main_filter" value="absences_only" <%= 'checked' if @main_filter == 'absences_only' %>>
          <span>Mais de 3 faltas nos últimos 15 dias</span>
        </label>
        <label style="display: block; margin: 8px 0;">
          <input type="radio" name="main_filter" value="low_frequency_only" <%= 'checked' if @main_filter == 'low_frequency_only' %>>
          <span>Menos de 80% de frequência no ano</span>
        </label>        
      </div>
      <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #dee2e6;">
        <strong>Classificação de Risco:</strong>
        <label title="Frequência igual ou superior a 80%">
          <input type="checkbox" name="risk_classifications[]" value="Adequado" <%= 'checked' if @selected_classifications.include?('Adequado') %>>
          <span style="background-color: #28a745; color: white; padding: 2px 8px; border-radius: 4px; font-weight: 600;">Adequado</span>
        </label>
        <label title="Frequência entre 75% e 79,9% (no limite mínimo)">
          <input type="checkbox" name="risk_classifications[]" value="Atenção" <%= 'checked' if @selected_classifications.include?('Atenção') %>>
          <span style="background-color: #ffc107; color: white; padding: 2px 8px; border-radius: 4px; font-weight: 600;">Atenção</span>
        </label>
        <label title="Frequência entre 50% e 74,9% (abaixo do mínimo de 75%)">
          <input type="checkbox" name="risk_classifications[]" value="Abaixo do Mínimo" <%= 'checked' if @selected_classifications.include?('Abaixo do Mínimo') %>>
          <span style="background-color: #fd7e14; color: white; padding: 2px 8px; border-radius: 4px; font-weight: 600;">Abaixo do Mínimo</span>
        </label>
        <label title="Frequência inferior a 50%">
          <input type="checkbox" name="risk_classifications[]" value="Crítico" <%= 'checked' if @selected_classifications.include?('Crítico') %>>
          <span style="background-color: #dc3545; color: white; padding: 2px 8px; border-radius: 4px; font-weight: 600;">Crítico</span>
        </label>
        <label title="Professor(a) fez menos de 15 registros de frequência na turma">
          <input type="checkbox" name="risk_classifications[]" value="Dados insuficientes" <%= 'checked' if @selected_classifications.include?('Dados insuficientes') %>>
          <span style="background-color: #6c757d; color: white; padding: 2px 8px; border-radius: 4px; font-weight: 600;">Dados insuficientes</span>
        </label>
      </div>
    </form>
  </div>


  <% if @classrooms_data.empty? %>
    <p style="text-align: center; padding: 20px;">Nenhuma turma encontrada</p>
  <% else %>
    <% @classrooms_data.each do |classroom_data| %>
      <% next if classroom_data[:students].empty? %>
      
      <h3 style="margin-bottom: 15px; margin-top: 20px; color: #1D72B8;">
        Turma: <%= classroom_data[:classroom_name] %>
      </h3>
      
      <table>
        <thead>
          <tr>
            <th style="text-align: left;">#</th>
            <th style="text-align: left;">Nome<br>do aluno</th>
            <th style="text-align: center;">Faltas<br>(últimos 15 dias)</th>
            <th style="text-align: center;">Faltas Acumuladas<br>no Ano</th>
            <th style="text-align: center;">Percentual de<br>Frequência no Ano (%)</th>
            <th style="text-align: center;">Última<br>Presença</th>
            <th style="text-align: center;">Classificação<br>de Risco</th>
            <th
              style="text-align: left;"
              title="<%= t('pedagogical_trackings.index.top_absence_disciplines_hint') %>"
            >
              <%= t('pedagogical_trackings.index.top_absence_disciplines').html_safe %>
            </th>
            <th style="text-align: center;"><%= t('pedagogical_trackings.index.observations') %></th>
          </tr>
        </thead>
        <tbody>
          <% classroom_data[:students].each_with_index do |student, index| %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= student[:student_name] %></td>
              <td style="text-align: center;">
                <%= student[:absences_15_days] %>
              </td>
              <td style="text-align: center;">
                <%= student[:absences_year] %>
              </td>
              <td style="text-align: center;">
                <% 
                  percentage_value = student[:frequency_percentage] || 0
                  # Se o valor for menor que 1, significa que está em formato decimal (0.52 = 52%)
                  # Multiplicar por 100 para exibir corretamente
                  if percentage_value < 1 && percentage_value > 0
                    percentage_value = percentage_value * 100
                  end
                  formatted_value = number_with_precision(percentage_value, precision: 1)
                %>
                <%= formatted_value %>%
              </td>
              <td style="text-align: center;">
                <%= student[:last_presence_date] ? student[:last_presence_date].strftime('%d/%m/%Y') : '-' %>
              </td>
              <td style="text-align: center;">
                <% 
                  risk_color = case student[:risk_classification]
                                when 'Adequado'
                                  '#28a745' # Verde
                                when 'Atenção'
                                  '#ffc107' # Amarelo
                                when 'Crítico'
                                  '#dc3545' # Vermelho
                                when 'Dados insuficientes'
                                  '#6c757d' # Cinza
                                else
                                  '#fd7e14' # Laranja
                                end
                %>
                <span
                  style="background-color: <%= risk_color %>; color: white; padding: 4px 8px; border-radius: 4px; font-weight: 600; display: inline-block; white-space: nowrap;"
                  <% if student[:risk_classification] == 'Dados insuficientes' %>
                    title="Professor(a) fez menos de 15 registros de frequência na turma"
                  <% end %>
                >
                  <%= student[:risk_classification] %>
                </span>
              </td>
              <td style="text-align: left; font-size: 12px; line-height: 1.4;">
                <% top_disciplines = student[:top_absence_disciplines] || [] %>
                <% if top_disciplines.any? %>
                  <%= top_disciplines.map { |d| "#{d[:name]} (#{d[:count]})" }.join(', ') %>
                <% else %>
                  -
                <% end %>
              </td>
              <td style="text-align: center;">
                <div class="student-observations-cell">
                  <% observations_count = student[:observations_count].to_i %>
                  <% if observations_count.positive? %>
                    <a
                      href="<%= student_observations_pdf_pedagogical_trackings_path(
                        student_id: student[:student_id],
                        classroom_id: classroom_data[:classroom_id],
                        unity_id: params[:unity_id]
                      ) %>"
                      target="_blank"
                      class="student-observations-count"
                      data-student-id="<%= student[:student_id] %>"
                      data-classroom-id="<%= classroom_data[:classroom_id] %>"
                      title="<%= t('pedagogical_trackings.index.observations_pdf_hint') %>"
                    >
                      <%= observations_count %>
                    </a>
                  <% else %>
                    <span
                      class="student-observations-count"
                      data-student-id="<%= student[:student_id] %>"
                      data-classroom-id="<%= classroom_data[:classroom_id] %>"
                    >0</span>
                  <% end %>
                  <button
                    type="button"
                    class="student-observations-add"
                    onclick="openObservationFromFrequencyModal(this)"
                    data-student-id="<%= student[:student_id] %>"
                    data-student-name="<%= student[:student_name] %>"
                    data-classroom-id="<%= classroom_data[:classroom_id] %>"
                    data-unity-id="<%= params[:unity_id] %>"
                    title="<%= t('pedagogical_trackings.create_observation.button_title') %>"
                    aria-label="<%= t('pedagogical_trackings.create_observation.button_title') %>"
                  >
                    +
                  </button>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
    
    <% if @classrooms_data.all? { |c| c[:students].empty? } %>
      <p style="text-align: center; padding: 20px;">Nenhum aluno faltoso encontrado</p>
    <% end %>
  <% end %>
</div>

