<tbody id="resources-tbody">
<% if @percents.empty? %>
  <tr>
    <td class="no_record_found" colspan="4"> <%= t('views.index.no_record_found')%></td>
  </tr>
<% else %>
  <% @percents.each do |record| %>
    <tr>
      <td>
        <%= record.classroom_id.present? ? record.classroom_description : record.unity_name %>
      </td>

      <% if record.classroom_id.present? %>
        <td>
          <%= record.frequency_percentage %>%
          <div class="frequency_percentage_total">
            <div id="<%= record.classroom_id.present? ? record.classroom_id : record.unity_id %>_frequency_percentage_done"
                  class="frequency_percentage_done"
                  style="width: <%= record.frequency_percentage %>%">
            </div>
          </div>
        </td>
        <td>
          <%= record.content_record_percentage %>%
          <div class="content_record_percentage_total">
            <div id="<%= record.classroom_id.present? ? record.classroom_id : record.unity_id %>_content_record_percentage_done"
                  class="content_record_percentage_done"
                  style="width: <%= record.content_record_percentage %>%">
            </div>
          </div>
        </td>
      <% end %>

      <td class="actions" style="text-align: center;">
        <button onclick="openResumeModal(<%= record.unity_id %>, <%= record.classroom_id %>); return false;"
                class="bg-green-600 text-white px-4 py-2 rounded-lg">
          Resumo de lançamentos
        </button>

        <%= render_details_link(record) %>
      </td>
    </tr>
  <% end %>
<% end %>
</tbody>

<div id="resumeModal" style="display:none; position:fixed; inset:0; background-color:rgba(0,0,0,0.7);
                             justify-content:center; align-items:center; z-index:9999;">
  <div style="background:white; padding:20px; border-radius:15px; height:95vh; overflow:auto; width:90%; box-shadow:0 5px 15px rgba(0,0,0,0.3);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
      <h2 style="margin:0; font-size:1.5em;">Resumo de Lançamentos</h2>
      <!-- Botão de baixar planilha -->
      
      <button id="downloadXlsxBtn" style="background-color:#1D72B8; color:white; padding:10px 15px; border-radius:8px; border:none; cursor:pointer;">Baixar planilha</button>
      <button onclick="closeResumeModal(event)" style="background:none; border:none; font-size:3.5em; cursor:pointer;">&times;</button>      
    </div>

    <div id="resumeModalBody" style="margin-bottom:15px;">
      <!-- Conteúdo da planilha será injetado aqui -->
    </div>

  </div>
</div>
