<% report = report_card %>
<% sheet = report[:sheet] || {} %>
<% texto_situacao = sheet[:status].to_s %>
<% classe_situacao = if texto_situacao.casecmp('Cursando').zero?
  'boletim-situacao-cursando'
elsif texto_situacao.match?(/\Aaprov/i) || texto_situacao.match?(/\Aapr\./i)
  'boletim-situacao-aprovado'
elsif texto_situacao.match?(/\Areprov/i) || texto_situacao.match?(/\Arep\./i)
  'boletim-situacao-reprovado'
end %>

<style>
  body.dashboard #main,
  body.dashboard #content,
  body.dashboard #content-page,
  body.dashboard #widget-grid,
  body.dashboard #widget-grid > .row,
  body.dashboard #widget-grid article,
  body.dashboard .jarviswidget,
  body.dashboard .jarviswidget > div {
    max-width: 100%;
    min-width: 0;
  }
  .boletim { color: #1a1a1a; font-size: 14px; max-width: 100%; min-width: 0; }
  .boletim-topo { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .boletim-identificacao { min-width: 0; }
  .boletim-kicker { margin: 0; font-size: 13px; color: #4b5563; font-weight: 700; letter-spacing: 0.02em; }
  .boletim-nome-aluno { margin: 2px 0 0; font-size: 18px; font-weight: 700; line-height: 1.2; }
  .boletim-ano { margin: 4px 0 0; color: #4b5563; font-size: 13px; }
  .boletim-situacao { color: #1a1a1a; font-weight: 700; white-space: nowrap; padding-bottom: 12px; }
  .boletim-situacao-cursando { color: #0b6e99; }
  .boletim-situacao-aprovado { color: #17693c; }
  .boletim-situacao-reprovado { color: #6b7280; }
  .boletim-situacao-rotulo { display: none; }
  .boletim-turma-rotulo { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
  .boletim-turma-rotulo label { margin-bottom: 0; }
  .boletim-disciplina summary::marker { content: ''; }
  .boletim-impressao-topo { display: none; }
  .boletim-cabecalho-instituicao { display: flex; align-items: center; gap: 10px; margin: 0 0 8px; }
  .boletim-logo { width: 52px; height: 52px; object-fit: contain; }
  .boletim-cabecalho-instituicao p { margin: 0; font-size: 11px; line-height: 1.3; }
  .boletim-cabecalho-entidade { font-size: 13px; font-weight: 700; }
  .boletim-turma { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 8px 16px; margin: 12px 0; }
  .boletim-turma form { flex: 1 1 200px; max-width: 280px; min-width: 0; margin: 0; }
  .boletim-turma label { display: block; margin-bottom: 4px; font-size: 13px; }
  .boletim-turma select { width: 100%; min-height: 44px; }
  .boletim-scroll {
    display: none;
    width: 100%;
    max-width: 100%;
    max-height: max(240px, calc(100vh - 340px));
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    border: 0;
    touch-action: pan-x pan-y;
  }
  .boletim-scroll::-webkit-scrollbar { width: 12px; height: 12px; }
  .boletim-scroll::-webkit-scrollbar-thumb { background: #8b95a1; border-radius: 8px; }
  .boletim-scroll::-webkit-scrollbar-track { background: #eef1f4; }
  .boletim-planilha { border-collapse: collapse; width: max-content; min-width: 100%; font-size: 12px; }
  .boletim-planilha th,
  .boletim-planilha td { border: 1px solid #222; padding: 6px 8px; text-align: center; background: #fff; vertical-align: middle; white-space: nowrap; }
  .boletim-planilha th { background: #f3f4f6; font-size: 11px; font-weight: 700; line-height: 1.2; position: sticky; z-index: 2; }
  .boletim-planilha thead tr:first-child th { top: 0; }
  .boletim-planilha thead tr:nth-child(2) th { top: 32px; }
  .boletim-planilha .largo,
  .boletim-planilha td:first-child { text-align: left; min-width: 160px; max-width: 220px; white-space: normal; position: sticky; left: 0; z-index: 3; }
  .boletim-planilha th.largo { z-index: 4; background: #f3f4f6; top: 0; }
  .boletim-planilha td:first-child { background: #fff; font-weight: 600; }
  .boletim-dica { margin: 8px 0 0; color: #4b5563; font-size: 13px; }
  .boletim-dica-horizontal { display: none; }
  .boletim-vertical { display: grid; gap: 8px; margin-top: 12px; }
  .boletim-disciplina details { border: 1px solid #d5dbe3; border-radius: 12px; background: #fff; }
  .boletim-disciplina summary { display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 10px 14px; background: #f4f7fb; border-radius: 12px; font-size: 16px; font-weight: 700; cursor: pointer; list-style: none; }
  .boletim-disciplina summary::-webkit-details-marker { display: none; }
  .boletim-disciplina details[open] summary { border-radius: 12px 12px 0 0; }
  .boletim-disciplina summary::after { content: ''; width: 8px; height: 8px; margin-top: -4px; border-right: 2px solid #526173; border-bottom: 2px solid #526173; transform: rotate(45deg); flex: 0 0 auto; }
  .boletim-disciplina details[open] summary::after { margin-top: 4px; transform: rotate(-135deg); }
  .boletim-disciplina-nome { flex: 1 1 auto; min-width: 0; }
  .boletim-etapas { display: flex; flex-wrap: wrap; gap: 8px; padding: 12px 14px 4px; }
  .boletim-etapa { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 64px; min-height: 56px; padding: 4px 8px; border: 1px solid #e5e7eb; border-radius: 10px; background: #fff; }
  .boletim-etapa small { color: #526173; font-size: 12px; font-weight: 700; }
  .boletim-etapa-valor { min-height: 32px; padding: 2px 4px; font-weight: 700; }
  .boletim-resumo-linha { display: flex; flex-wrap: wrap; gap: 10px 16px; margin: 0; padding: 8px 14px 12px; }
  .boletim-resumo-linha span { display: flex; flex-direction: column; min-width: 72px; }
  .boletim-resumo-linha small { color: #526173; font-size: 12px; font-weight: 600; }
  .boletim-resumo-linha strong { font-size: 15px; }
  .boletim-vazio { margin: 12px 0 0; font-size: 16px; }
  .boletim-pareceres { display: grid; gap: 18px; margin-top: 4px; }
  .boletim-parecer-grupo h4 { margin: 0; font-size: 16px; }
  .boletim-parecer-item { padding: 10px 0; border-top: 1px solid #e5e7eb; }
  .boletim-parecer-item h5 { margin: 0 0 4px; font-size: 15px; }
  .boletim-parecer-item p { margin: 0; white-space: pre-wrap; line-height: 1.5; }
  .boletim-parecer-frequencia { margin: 0; font-weight: 700; }
  .boletim-pdf { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 44px; margin: 0; padding: 10px 14px; border: 1px solid #17693c; border-radius: 8px; background: #fff; color: #17693c; font-size: 15px; font-weight: 700; cursor: pointer; }
  .boletim-pdf svg { width: 18px; height: 18px; }
  .boletim-nota { border: 0; background: transparent; color: #0b6e99; font: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; padding: 6px 4px; min-width: 44px; min-height: 36px; }
  .boletim-modal[hidden] { display: none; }
  .boletim-modal { position: fixed; inset: 0; z-index: 3000; display: flex; align-items: flex-end; justify-content: center; }
  .boletim-modal-fundo { position: absolute; inset: 0; background: rgba(17, 24, 39, 0.45); }
  .boletim-modal-caixa { position: relative; width: 100%; max-height: 85vh; overflow: auto; background: #fff; border-radius: 16px 16px 0 0; padding: 16px 16px 24px; }
  .boletim-modal-topo { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .boletim-modal-caixa h4 { margin: 0; font-size: 18px; }
  .boletim-modal-etapa { margin: 4px 0 12px; color: #4b5563; }
  .boletim-modal-fechar { border: 0; background: #f3f4f6; border-radius: 8px; min-height: 44px; padding: 8px 12px; font-weight: 700; cursor: pointer; }
  .boletim-modal-lista { margin: 0; padding: 0; list-style: none; }
  .boletim-modal-lista li { padding: 10px 0; border-bottom: 1px solid #e5e7eb; }
  .boletim-modal-lista strong { display: block; }
  .boletim-modal-nota { display: block; margin-top: 2px; font-weight: 700; }
  .boletim-modal-escala { margin: 0 0 12px; color: #526173; font-size: 14px; line-height: 1.4; }
  .boletim-parecer { margin: 12px 0 0; padding: 10px 12px; background: #f7f9fb; border-radius: 8px; }
  @media (max-width: 767px) {
    html,
    body.dashboard {
      height: auto !important;
      overflow-x: hidden !important;
      overflow-y: auto !important;
      -webkit-overflow-scrolling: touch;
    }
    body.dashboard #main,
    body.dashboard #content,
    body.dashboard #content-page,
    body.dashboard #widget-grid,
    body.dashboard .jarviswidget,
    body.dashboard .jarviswidget > div {
      overflow: visible !important;
      height: auto !important;
      max-height: none !important;
    }
    .boletim-topo { flex-wrap: nowrap; gap: 8px; }
    .boletim-identificacao { flex: 1 1 auto; }
    .boletim-nome-aluno { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .boletim-pdf { width: 44px; min-width: 44px; height: 44px; padding: 0; flex: 0 0 44px; }
    .boletim-pdf-texto { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; }
    .boletim-turma { display: block; }
    .boletim-turma form { max-width: none; width: 100%; }
    .boletim, .boletim * { box-sizing: border-box; }
    .boletim-turma > .boletim-situacao.boletim-situacao-campo { display: none; }
    .boletim-situacao-rotulo,
    .boletim-turma > .boletim-situacao:not(.boletim-situacao-campo) { display: inline-flex; align-items: center; min-height: 28px; padding: 2px 10px; border-radius: 999px; background: #f3f4f6; color: #1a1a1a; font-size: 13px; }
    .boletim-situacao-rotulo.boletim-situacao-cursando,
    .boletim-turma > .boletim-situacao-cursando:not(.boletim-situacao-campo) { background: #e7f3fa; color: #0b6e99; }
    .boletim-situacao-rotulo.boletim-situacao-aprovado,
    .boletim-turma > .boletim-situacao-aprovado:not(.boletim-situacao-campo) { background: #eef6f1; color: #17693c; }
    .boletim-situacao-rotulo.boletim-situacao-reprovado,
    .boletim-turma > .boletim-situacao-reprovado:not(.boletim-situacao-campo) { background: #f3f4f6; color: #6b7280; }
    .boletim-vertical { max-height: none; overflow: visible; }
  }
  @media (min-width: 768px) {
    .boletim-turma form { flex: 0 1 280px; }
    .boletim-pdf { width: auto; }
    .boletim-scroll { display: block; }
    .boletim-vertical { display: none; }
    .boletim-dica-vertical { display: none; }
    .boletim-dica-horizontal { display: block; }
    .boletim-planilha { font-size: 13px; }
    .boletim-modal { align-items: center; }
    .boletim-modal-caixa { width: 520px; max-width: 92vw; border-radius: 16px; max-height: 80vh; }
  }
  @media print {
    @page { size: A4 portrait; margin: 10mm; }
    html, body { background: #fff !important; height: auto !important; overflow: visible !important; }
    #header, #left-panel, #ribbon, .page-footer, nav, aside,
    .jarviswidget > header, #flash-messages, .boletim-topo, .boletim-turma,
    .boletim-dica, .boletim-pdf, .boletim-modal, .boletim-vertical { display: none !important; }
    .boletim-scroll { display: block !important; }
    .boletim-impressao-topo { display: block !important; margin-bottom: 8px; }
    .boletim-impressao-topo h1 { margin: 0 0 2px; font-size: 14px; }
    .boletim-impressao-topo .boletim-impressao-nome { margin: 0; font-size: 13px; font-weight: 700; }
    .boletim-impressao-topo p { margin: 0; font-size: 10px; }
    #main, #content, #content-page, #widget-grid, #widget-grid > .row,
    #widget-grid article, .jarviswidget, .jarviswidget > div, .boletim, .boletim-para-impressao {
      display: block !important;
      position: static !important;
      float: none !important;
      width: auto !important;
      max-width: none !important;
      min-height: 0 !important;
      height: auto !important;
      margin: 0 !important;
      padding: 0 !important;
      overflow: visible !important;
      border: 0 !important;
      box-shadow: none !important;
      background: #fff !important;
    }
    #main { margin-left: 0 !important; }
    .boletim-scroll { overflow: visible !important; max-height: none !important; border: 0 !important; }
    .boletim-planilha { width: 100% !important; min-width: 0 !important; table-layout: fixed !important; }
    .boletim-planilha th, .boletim-planilha td {
      position: static !important;
      white-space: normal !important;
      font-size: 7.5px !important;
      line-height: 1.2 !important;
      padding: 2px !important;
    }
    .boletim-planilha td:first-child, .boletim-planilha th.largo { width: 22% !important; }
    .boletim-planilha thead { display: table-header-group; }
    .boletim-planilha tr { break-inside: avoid; }
  }
</style>

<section class="boletim">
  <% if report[:blank] %>
    <p class="boletim-vazio"><%= report[:message] %></p>
  <% else %>
    <div class="boletim-topo">
      <div class="boletim-identificacao">
        <h3 class="boletim-nome-aluno"><%= report[:student_name] %></h3>
        <p class="boletim-ano">Ano letivo <%= report[:year] %> • <%= report[:classroom_name] %></p>
      </div>
      <% if sheet[:rows].present? || sheet[:opinions].present? %>
        <button type="button" class="boletim-pdf" onclick="abrirPdfBoletim();" aria-label="Baixar boletim completo em PDF">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3v12"></path>
            <path d="M7 11l5 5 5-5"></path>
            <path d="M5 21h14"></path>
          </svg>
          <span class="boletim-pdf-texto">Baixar boletim completo em PDF</span>
        </button>
      <% end %>
    </div>

    <% if report[:enrollments].size > 1 || sheet[:status].present? %>
      <div class="boletim-turma">
        <% if report[:enrollments].size > 1 %>
          <%= form_tag root_path, method: :get do %>
            <div class="boletim-turma-rotulo">
              <label for="classroom_id">Turma</label>
              <% if sheet[:status].present? %>
                <span class="boletim-situacao boletim-situacao-rotulo <%= classe_situacao %>"><%= sheet[:status] %></span>
              <% end %>
            </div>
            <%= select_tag :classroom_id,
                            options_for_select(report[:enrollments].map { |item| [item[:label], item[:id]] }, report[:selected_classroom_id]),
                            onchange: "this.form.submit()" %>
          <% end %>
          <% if sheet[:status].present? %>
            <span class="boletim-situacao boletim-situacao-campo <%= classe_situacao %>"><%= sheet[:status] %></span>
          <% end %>
        <% elsif sheet[:status].present? %>
          <span class="boletim-situacao <%= classe_situacao %>"><%= sheet[:status] %></span>
        <% end %>
      </div>
    <% end %>

    <div class="boletim-para-impressao">
    <div class="boletim-impressao-topo">
      <% cabecalho_pdf = report[:pdf_header] || {} %>
      <div class="boletim-cabecalho-instituicao">
        <% if cabecalho_pdf[:logo_url].present? %>
          <img class="boletim-logo" src="<%= cabecalho_pdf[:logo_url] %>" alt="">
        <% end %>
        <div>
          <% if cabecalho_pdf[:entity_name].present? %>
            <p class="boletim-cabecalho-entidade"><%= cabecalho_pdf[:entity_name] %></p>
          <% end %>
          <% if cabecalho_pdf[:organ_name].present? %>
            <p class="boletim-cabecalho-orgao"><%= cabecalho_pdf[:organ_name] %></p>
          <% end %>
          <% if cabecalho_pdf[:school_name].present? %>
            <p class="boletim-cabecalho-escola"><%= cabecalho_pdf[:school_name] %></p>
          <% end %>
        </div>
      </div>
      <h1>Boletim Escolar</h1>
      <p class="boletim-impressao-nome"><%= report[:student_name] %></p>
      <p class="boletim-impressao-meta">Ano letivo <%= report[:year] %> • <%= report[:classroom_name] %><% if sheet[:status].present? %> • <%= sheet[:status] %><% end %></p>
    </div>

    <% if sheet[:opinions].present? %>
      <div class="boletim-pareceres">
        <% sheet[:opinions].each do |grupo| %>
          <section class="boletim-parecer-grupo">
            <% if grupo[:title].present? %>
              <h4><%= grupo[:title] %></h4>
            <% end %>
            <% grupo[:items].each do |item| %>
              <article class="boletim-parecer-item">
                <% if item[:name].present? %>
                  <h5><%= item[:name] %></h5>
                <% end %>
                <p><%= item[:text] %></p>
              </article>
            <% end %>
          </section>
        <% end %>
        <% if sheet[:frequency_label].present? %>
          <p class="boletim-parecer-frequencia"><%= sheet[:frequency_label] %></p>
        <% end %>
      </div>
    <% elsif sheet[:rows].blank? %>
      <p class="boletim-vazio">O professor ainda não lançou as notas deste ano.</p>
    <% else %>
      <div class="boletim-scroll">
        <table class="boletim-planilha" style="min-width: <%= [(sheet[:rows].first[:values].size + 1) * 72, 320].max %>px;">
          <thead>
            <% sheet[:header].each do |header_row| %>
              <tr>
                <% header_row.each do |cell| %>
                  <th colspan="<%= cell[:colspan] %>" rowspan="<%= cell[:rowspan] %>" class="<%= cell[:css] %>"><%= cell[:text] %></th>
                <% end %>
              </tr>
            <% end %>
          </thead>
          <tbody>
            <% sheet[:rows].each_with_index do |row, row_index| %>
              <tr>
                <td><%= row[:name] %></td>
                <% row[:values].each_with_index do |value, col_index| %>
                  <td>
                    <% if value.is_a?(Hash) && value[:grade] && (value[:text].present? || value[:details].present? || value[:opinion].present? || value[:year_opinion].present?) %>
                      <button type="button" class="boletim-nota" data-avaliacao="<%= row_index %>-<%= col_index %>">
                        <%= value[:text].presence || '—' %>
                      </button>
                    <% else %>
                      <%= value.is_a?(Hash) ? value[:text] : value %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    </div>
    <% unless sheet[:rows].blank? %>
      <% etapa_curta = lambda do |rotulo|
        partes = rotulo.to_s.split('·').map(&:strip)
        base = partes.last.to_s
        base = partes.first.to_s if base.blank? || base.casecmp('NOTA').zero?
        base.split(/\s+/).first
      end %>
      <% resumo_curto = lambda do |rotulo|
        texto = rotulo.to_s
        if texto =~ /freq/i
          'Frequência'
        elsif texto =~ /falta/i
          'Faltas'
        elsif texto =~ /exame/i
          'Exame'
        elsif texto =~ /rec\.?\s*final/i
          'Rec. final'
        elsif texto =~ /\Arec/i
          'Recuperação'
        elsif texto =~ /m[eé]dia final 1/i
          'Média 1º'
        elsif texto =~ /m[eé]dia final 2/i
          'Média 2º'
        elsif texto =~ /m[eé]dia/i
          'Média'
        else
          texto
        end
      end %>
      <div class="boletim-vertical">
        <% sheet[:rows].each_with_index do |row, row_index| %>
          <% etapas = [] %>
          <% complementos = [] %>
          <% row[:values].each_with_index do |value, col_index| %>
            <% rotulo = sheet[:labels][col_index].to_s %>
            <% next if rotulo == 'F' %>
            <% texto = value.is_a?(Hash) ? value[:text].to_s : value.to_s %>
            <% if value.is_a?(Hash) && value[:grade] %>
              <% etapas << { rotulo: rotulo, value: value, col_index: col_index, texto: texto } %>
            <% else %>
              <% complementos << { rotulo: rotulo, texto: texto } %>
            <% end %>
          <% end %>
          <article class="boletim-disciplina">
            <details>
              <summary>
                <span class="boletim-disciplina-nome"><%= row[:name] %></span>
              </summary>
              <% if etapas.any? %>
                <div class="boletim-etapas">
                  <% etapas.each do |etapa| %>
                    <% valor = etapa[:value] %>
                    <% clicavel = valor[:text].present? || valor[:details].present? || valor[:opinion].present? || valor[:year_opinion].present? %>
                    <div class="boletim-etapa">
                      <small><%= etapa_curta.call(etapa[:rotulo]) %></small>
                      <% if clicavel %>
                        <button type="button" class="boletim-nota" data-avaliacao="<%= row_index %>-<%= etapa[:col_index] %>">
                          <%= etapa[:texto].presence || '—' %>
                        </button>
                      <% else %>
                        <span class="boletim-etapa-valor"><%= etapa[:texto].presence || '—' %></span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
              <% if complementos.any? %>
                <div class="boletim-resumo-linha">
                  <% complementos.each do |item| %>
                    <span>
                      <small><%= resumo_curto.call(item[:rotulo]) %></small>
                      <strong><%= item[:texto].presence || '—' %></strong>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </details>
          </article>
        <% end %>
      </div>
      <script>
        document.querySelectorAll('.boletim-disciplina details').forEach(function(item) {
          item.addEventListener('toggle', function() {
            if (!item.open) return;
            document.querySelectorAll('.boletim-disciplina details[open]').forEach(function(outro) {
              if (outro !== item) outro.removeAttribute('open');
            });
          });
        });
      </script>
    <% end %>
    <% if sheet[:rows].present? || sheet[:opinions].present? %>
      <% if sheet[:rows].present? %>
      <% avaliacoes = {} %>
      <% sheet[:rows].each_with_index do |row, row_index| %>
        <% row[:values].each_with_index do |value, col_index| %>
          <% next unless value.is_a?(Hash) && value[:grade] %>
          <% avaliacoes["#{row_index}-#{col_index}"] = value.slice(:discipline, :step, :score, :details, :scale_note, :opinion, :year_opinion) %>
        <% end %>
      <% end %>
      <p class="boletim-dica boletim-dica-vertical">Toque na matéria para ver as etapas. Toque na nota para ver as avaliações.</p>
      <p class="boletim-dica boletim-dica-horizontal">Deslize a tabela para ver todas as colunas. Toque na nota para ver as avaliações do bimestre.</p>

      <div class="boletim-modal" id="boletim-modal" hidden>
        <div class="boletim-modal-fundo" data-fechar="true"></div>
        <div class="boletim-modal-caixa" role="dialog" aria-modal="true" aria-labelledby="boletim-modal-titulo">
          <div class="boletim-modal-topo">
            <h4 id="boletim-modal-titulo"></h4>
            <button type="button" class="boletim-modal-fechar" data-fechar="true">Fechar</button>
          </div>
          <p class="boletim-modal-etapa" id="boletim-modal-etapa"></p>
          <div id="boletim-modal-corpo"></div>
        </div>
      </div>

      <script type="application/json" id="boletim-avaliacoes-dados"><%= raw json_escape(avaliacoes.to_json) %></script>
      <% end %>
      <script>
        function abrirPdfBoletim() {
          var bloco = document.querySelector('.boletim-para-impressao');
          if (!bloco) return;

          var topo = bloco.querySelector('.boletim-impressao-topo');
          var metaEl = topo ? topo.querySelector('.boletim-impressao-meta') : null;
          var instituicaoEl = bloco.querySelector('.boletim-cabecalho-instituicao');
          var instituicao = {
            entidade: textoPdf(instituicaoEl && instituicaoEl.querySelector('.boletim-cabecalho-entidade') ? instituicaoEl.querySelector('.boletim-cabecalho-entidade').textContent : ''),
            orgao: textoPdf(instituicaoEl && instituicaoEl.querySelector('.boletim-cabecalho-orgao') ? instituicaoEl.querySelector('.boletim-cabecalho-orgao').textContent : ''),
            escola: textoPdf(instituicaoEl && instituicaoEl.querySelector('.boletim-cabecalho-escola') ? instituicaoEl.querySelector('.boletim-cabecalho-escola').textContent : '')
          };
          var tabela = bloco.querySelector('table');
          var linhas = [];
          var cabecalho = tabela && tabela.tHead ? tabela.tHead.rows.length : 0;

          if (tabela) {
            Array.prototype.forEach.call(tabela.rows, function(tr) {
              var celulas = [];
              Array.prototype.forEach.call(tr.cells, function(cell) {
                celulas.push({
                  texto: textoPdf(cell.textContent),
                  colspan: cell.colSpan || 1,
                  rowspan: cell.rowSpan || 1,
                  cabecalho: cell.tagName === 'TH'
                });
              });
              linhas.push(celulas);
            });
          }

          var pareceres = [];
          bloco.querySelectorAll('.boletim-parecer-grupo').forEach(function(grupo) {
            var titulo = grupo.querySelector('h4');
            var itens = [];
            grupo.querySelectorAll('.boletim-parecer-item').forEach(function(item) {
              var nome = item.querySelector('h5');
              var texto = item.querySelector('p');
              itens.push({
                nome: nome ? textoParecer(nome.textContent) : '',
                texto: texto ? textoParecer(texto.textContent) : ''
              });
            });
            pareceres.push({ titulo: titulo ? textoParecer(titulo.textContent) : '', itens: itens });
          });
          var frequencia = bloco.querySelector('.boletim-parecer-frequencia');
          var modelo = {
            titulo: textoPdf(topo ? topo.querySelector('h1').textContent : 'Boletim Escolar'),
            nome: textoPdf(topo ? topo.querySelector('.boletim-impressao-nome').textContent : ''),
            meta: textoPdf(metaEl ? metaEl.textContent : ''),
            linhas: linhas,
            cabecalho: cabecalho,
            pareceres: pareceres,
            frequencia: frequencia ? textoParecer(frequencia.textContent) : '',
            instituicao: instituicao
          };

          function publicar(logo) {
            modelo.logo = logo;
            var arquivo = new File([construirPdfBoletim(modelo)], 'boletim.pdf', { type: 'application/pdf' });
            var url = URL.createObjectURL(arquivo);
            var janela = window.open(url, '_blank');
            if (!janela) {
              var link = document.createElement('a');
              link.href = url;
              link.target = '_blank';
              document.body.appendChild(link);
              link.click();
              link.remove();
            }
            setTimeout(function() { URL.revokeObjectURL(url); }, 60000);
          }

          var img = instituicaoEl ? instituicaoEl.querySelector('.boletim-logo') : null;
          if (!img || !img.getAttribute('src')) {
            publicar(null);
            return;
          }
          function converter() { publicar(logoJpeg(img)); }
          if (img.complete) {
            converter();
          } else {
            img.addEventListener('load', converter);
            img.addEventListener('error', function() { publicar(null); });
          }
        }

        function textoPdf(valor) {
          return String(valor || '').replace(/\s+/g, ' ').trim();
        }

        function textoParecer(valor) {
          return String(valor || '').replace(/\r\n/g, '\n').replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
        }

        function logoJpeg(img) {
          try {
            if (!img || !img.naturalWidth) return null;
            var limite = 160;
            var escala = Math.min(limite / img.naturalWidth, limite / img.naturalHeight, 1);
            var largura = Math.max(1, Math.round(img.naturalWidth * escala));
            var altura = Math.max(1, Math.round(img.naturalHeight * escala));
            var canvas = document.createElement('canvas');
            canvas.width = largura;
            canvas.height = altura;
            var contexto = canvas.getContext('2d');
            contexto.fillStyle = '#ffffff';
            contexto.fillRect(0, 0, largura, altura);
            contexto.drawImage(img, 0, 0, largura, altura);
            var base64 = canvas.toDataURL('image/jpeg', 0.86).split(',')[1];
            var binario = atob(base64);
            var hex = '';
            for (var i = 0; i < binario.length; i++) {
              var byte = binario.charCodeAt(i).toString(16).toUpperCase();
              hex += byte.length < 2 ? '0' + byte : byte;
            }
            return { width: largura, height: altura, hex: hex + '>' };
          } catch (erro) {
            return null;
          }
        }

        function construirPdfBoletim(modelo) {
          var paginaLargura = 595.28;
          var paginaAltura = 841.89;
          var margem = 28;
          var larguraUtil = paginaLargura - margem * 2;
          var largurasLetra = {
            ' ': 278, 'i': 222, 'l': 222, 'I': 278, 'j': 222, 'f': 278, 't': 278, 'r': 333,
            'a': 556, 'b': 556, 'c': 500, 'd': 556, 'e': 556, 'g': 556, 'h': 556, 'k': 500,
            'n': 556, 'o': 556, 'p': 556, 'q': 556, 's': 500, 'u': 556, 'v': 500, 'x': 500,
            'y': 500, 'z': 500, 'm': 833, 'w': 722,
            'A': 667, 'B': 667, 'C': 722, 'D': 722, 'E': 667, 'F': 611, 'G': 778, 'H': 722,
            'J': 500, 'K': 667, 'L': 556, 'M': 833, 'N': 722, 'O': 778, 'P': 667, 'Q': 778,
            'R': 722, 'S': 667, 'T': 611, 'U': 722, 'V': 667, 'W': 944, 'X': 667, 'Y': 667, 'Z': 611
          };
          var troca = {
            '\u2022': '\u00B7', '\u2013': '-', '\u2014': '-', '\u2018': "'", '\u2019': "'",
            '\u201C': '"', '\u201D': '"', '\u00A0': ' ', '\u2026': '...'
          };
          var semAcento = {
            '\u00E1': 'a', '\u00E0': 'a', '\u00E2': 'a', '\u00E3': 'a', '\u00E4': 'a',
            '\u00E9': 'e', '\u00EA': 'e', '\u00ED': 'i', '\u00F3': 'o', '\u00F4': 'o', '\u00F5': 'o',
            '\u00FA': 'u', '\u00E7': 'c', '\u00C1': 'A', '\u00C0': 'A', '\u00C2': 'A', '\u00C3': 'A',
            '\u00C9': 'E', '\u00CA': 'E', '\u00CD': 'I', '\u00D3': 'O', '\u00D4': 'O', '\u00D5': 'O',
            '\u00DA': 'U', '\u00C7': 'C', '\u00BA': 'o', '\u00AA': 'a'
          };

          function normalizar(texto) {
            var origem = textoPdf(texto);
            var saida = '';
            for (var i = 0; i < origem.length; i++) {
              var ch = origem.charAt(i);
              if (troca[ch]) saida += troca[ch];
              else if (origem.charCodeAt(i) > 255) saida += '?';
              else saida += ch;
            }
            return saida;
          }

          function medir(texto, tamanho, negrito) {
            var fator = negrito ? 1.08 : 1;
            var soma = 0;
            for (var i = 0; i < texto.length; i++) {
              var ch = texto.charAt(i);
              var base = semAcento[ch] || ch;
              var unidade = largurasLetra[base];
              if (!unidade) unidade = /[0-9]/.test(base) ? 556 : 500;
              soma += unidade / 1000 * tamanho * fator;
            }
            return soma;
          }

          function quebrar(texto, tamanho, larguraMax, negrito) {
            var palavras = normalizar(texto).split(' ');
            var linhas = [];
            var atual = '';

            function quebrarPalavra(palavra) {
              var pedaco = '';
              for (var i = 0; i < palavra.length; i++) {
                var tentativa = pedaco + palavra.charAt(i);
                if (medir(tentativa, tamanho, negrito) <= larguraMax || !pedaco) pedaco = tentativa;
                else {
                  linhas.push(pedaco);
                  pedaco = palavra.charAt(i);
                }
              }
              return pedaco;
            }

            palavras.forEach(function(palavra) {
              if (!palavra) return;
              if (medir(palavra, tamanho, negrito) > larguraMax) {
                if (atual) linhas.push(atual);
                atual = quebrarPalavra(palavra);
                return;
              }
              var tentativa = atual ? atual + ' ' + palavra : palavra;
              if (medir(tentativa, tamanho, negrito) <= larguraMax) atual = tentativa;
              else {
                if (atual) linhas.push(atual);
                atual = palavra;
              }
            });
            if (atual) linhas.push(atual);
            return linhas.length ? linhas : [''];
          }

          function escapar(texto) {
            var saida = '';
            var valor = normalizar(texto);
            for (var i = 0; i < valor.length; i++) {
              var ch = valor.charAt(i);
              var codigo = valor.charCodeAt(i);
              if (ch === '\\' || ch === '(' || ch === ')') saida += '\\' + ch;
              else if (codigo >= 32 && codigo <= 126) saida += ch;
              else if (codigo >= 160 && codigo <= 255) saida += '\\' + ('000' + codigo.toString(8)).slice(-3);
              else saida += '?';
            }
            return saida;
          }

          function numero(valor) {
            return String(Math.round(valor * 100) / 100);
          }

          var colunas = 0;
          modelo.linhas.forEach(function(celulas) {
            var coluna = 0;
            celulas.forEach(function(celula) {
              colunas = Math.max(colunas, coluna + celula.colspan);
              coluna += celula.colspan;
            });
          });

          var larguras = [];
          if (colunas <= 1) {
            larguras = [larguraUtil];
          } else {
            var primeira = Math.round(larguraUtil * 0.22 * 100) / 100;
            var restante = larguraUtil - primeira;
            var comum = restante / (colunas - 1);
            larguras = [primeira];
            for (var coluna = 1; coluna < colunas; coluna++) larguras.push(comum);
            var soma = 0;
            larguras.forEach(function(largura) { soma += largura; });
            larguras[larguras.length - 1] += larguraUtil - soma;
          }

          var posicoes = [margem];
          larguras.forEach(function(largura) {
            posicoes.push(posicoes[posicoes.length - 1] + largura);
          });

          var alturas = modelo.linhas.map(function() { return 14; });
          var ocupado = [];
          modelo.linhas.forEach(function(celulas, linha) {
            var coluna = 0;
            celulas.forEach(function(celula) {
              while (ocupado[linha] && ocupado[linha][coluna]) coluna += 1;
              celula.coluna = coluna;
              celula.linha = linha;
              for (var profundidade = 0; profundidade < celula.rowspan; profundidade++) {
                ocupado[linha + profundidade] = ocupado[linha + profundidade] || [];
                for (var deslocamento = 0; deslocamento < celula.colspan; deslocamento++) {
                  ocupado[linha + profundidade][coluna + deslocamento] = true;
                }
              }
              var largura = posicoes[coluna + celula.colspan] - posicoes[coluna] - 4;
              var tamanho = celula.cabecalho ? 6 : 7;
              var negrito = !!celula.cabecalho || coluna === 0;
              celula.tamanho = tamanho;
              celula.negrito = negrito;
              celula.linhasTexto = quebrar(celula.texto, tamanho, Math.max(8, largura), negrito);
              var precisa = celula.linhasTexto.length * (tamanho + 1.6) + 4;
              if (celula.rowspan <= 1) alturas[linha] = Math.max(alturas[linha], precisa);
              else celula.alturaNecessaria = precisa;
              coluna += celula.colspan;
            });
          });
          modelo.linhas.forEach(function(celulas, linha) {
            celulas.forEach(function(celula) {
              if (!celula.alturaNecessaria) return;
              var soma = 0;
              for (var i = 0; i < celula.rowspan; i++) soma += alturas[linha + i] || 0;
              if (celula.alturaNecessaria > soma && alturas[linha + celula.rowspan - 1] !== undefined) {
                alturas[linha + celula.rowspan - 1] += celula.alturaNecessaria - soma;
              }
            });
          });

          function comandoTexto(x, y, fonte, tamanho, texto) {
            return 'BT ' + fonte + ' ' + numero(tamanho) + ' Tf ' + numero(x) + ' ' + numero(y) + ' Td (' + escapar(texto) + ') Tj ET';
          }

          function desenharCelula(comandos, celula, topo) {
            var x = posicoes[celula.coluna];
            var largura = posicoes[celula.coluna + celula.colspan] - x;
            var altura = 0;
            for (var i = 0; i < celula.rowspan; i++) altura += alturas[celula.linha + i] || 0;
            var base = topo - altura;
            if (celula.cabecalho) {
              comandos.push('0.94 g');
              comandos.push(numero(x) + ' ' + numero(base) + ' ' + numero(largura) + ' ' + numero(altura) + ' re f');
              comandos.push('0 g');
            }
            comandos.push('0.15 w');
            comandos.push('0 0 0 RG');
            comandos.push(numero(x) + ' ' + numero(base) + ' ' + numero(largura) + ' ' + numero(altura) + ' re S');
            var entrelinha = celula.tamanho + 1.6;
            var bloco = celula.linhasTexto.length * entrelinha;
            var baseline = base + (altura - bloco) / 2 + (celula.linhasTexto.length - 1) * entrelinha + celula.tamanho * 0.25;
            celula.linhasTexto.forEach(function(linhaTexto, indice) {
              if (!linhaTexto) return;
              var larguraTexto = medir(linhaTexto, celula.tamanho, celula.negrito);
              var xTexto = celula.coluna === 0 ? x + 2 : x + (largura - larguraTexto) / 2;
              if (xTexto < x + 1) xTexto = x + 1;
              comandos.push(comandoTexto(xTexto, baseline - indice * entrelinha, celula.negrito ? '/F2' : '/F1', celula.tamanho, linhaTexto));
            });
          }

          var paginas = [];
          var comandos = [];
          var cursor = paginaAltura - margem;
          var cabecalho = Math.min(modelo.cabecalho || 0, modelo.linhas.length);

          function desenharParagrafo(texto, tamanho, fonte, negrito) {
            quebrar(texto, tamanho, larguraUtil, negrito).forEach(function(linha) {
              comandos.push(comandoTexto(margem, cursor - tamanho, fonte, tamanho, linha));
              cursor -= tamanho + 3;
            });
          }

          function desenharInstituicao() {
            var info = modelo.instituicao || {};
            if (!info.entidade && !info.orgao && !info.escola && !modelo.logo) return;

            var logoLargura = 0;
            var logoAltura = 0;
            if (modelo.logo) {
              var escalaLogo = Math.min(46 / modelo.logo.width, 46 / modelo.logo.height);
              logoLargura = modelo.logo.width * escalaLogo;
              logoAltura = modelo.logo.height * escalaLogo;
              comandos.push('q ' + numero(logoLargura) + ' 0 0 ' + numero(logoAltura) + ' ' + numero(margem) + ' ' + numero(cursor - logoAltura) + ' cm /Im1 Do Q');
            }

            var xTexto = margem + (logoLargura ? logoLargura + 8 : 0);
            var larguraTexto = Math.max(80, larguraUtil - (xTexto - margem));
            var yTexto = cursor;
            function escreverLinha(texto, tamanho, fonte, negrito) {
              if (!texto) return;
              quebrar(texto, tamanho, larguraTexto, negrito).forEach(function(linha) {
                comandos.push(comandoTexto(xTexto, yTexto - tamanho, fonte, tamanho, linha));
                yTexto -= tamanho + 2;
              });
            }
            escreverLinha(info.entidade, 11, '/F2', true);
            escreverLinha(info.orgao, 9, '/F1', false);
            escreverLinha(info.escola, 9, '/F1', false);
            cursor -= Math.max(logoAltura, cursor - yTexto) + 6;
            comandos.push('0.6 w 0 0 0 RG ' + numero(margem) + ' ' + numero(cursor) + ' m ' + numero(paginaLargura - margem) + ' ' + numero(cursor) + ' l S');
            cursor -= 10;
          }

          function desenharFaixa(inicio, fim, incluirTopo) {
            if (incluirTopo) {
              desenharInstituicao();
              desenharParagrafo(modelo.titulo || 'Boletim Escolar', 13, '/F2', true);
              if (modelo.nome) {
                cursor -= 1;
                desenharParagrafo(modelo.nome, 11, '/F2', true);
              }
              if (modelo.meta) {
                cursor -= 1;
                desenharParagrafo(modelo.meta, 9, '/F1', false);
              }
              cursor -= 8;
            }
            for (var linha = inicio; linha < fim; linha++) {
              var topo = cursor;
              modelo.linhas[linha].forEach(function(celula) { desenharCelula(comandos, celula, topo); });
              cursor -= alturas[linha] || 0;
            }
          }

          function novaPagina(incluirTopo) {
            if (comandos.length) paginas.push(comandos.join('\n'));
            comandos = [];
            cursor = paginaAltura - margem;
            desenharFaixa(0, cabecalho, incluirTopo);
          }

          if (modelo.pareceres && modelo.pareceres.length) {
            var garantirEspaco = function(altura) {
              if (cursor - altura >= margem) return;
              if (comandos.length) paginas.push(comandos.join('\n'));
              comandos = [];
              cursor = paginaAltura - margem;
            };

            var escrever = function(texto, tamanho, fonte, negrito) {
              String(texto || '').split('\n').forEach(function(paragrafo) {
                if (!paragrafo.trim()) {
                  garantirEspaco(8);
                  cursor -= 6;
                  return;
                }
                quebrar(paragrafo, tamanho, larguraUtil, negrito).forEach(function(linha) {
                  if (!linha) return;
                  garantirEspaco(tamanho + 4);
                  comandos.push(comandoTexto(margem, cursor - tamanho, fonte, tamanho, linha));
                  cursor -= tamanho + 3;
                });
              });
            }

            desenharInstituicao();
            escrever(modelo.titulo || 'Boletim Escolar', 13, '/F2', true);
            if (modelo.nome) {
              cursor -= 1;
              escrever(modelo.nome, 11, '/F2', true);
            }
            if (modelo.meta) {
              cursor -= 1;
              escrever(modelo.meta, 9, '/F1', false);
            }
            cursor -= 8;
            modelo.pareceres.forEach(function(grupo) {
              cursor -= 4;
              if (grupo.titulo) escrever(grupo.titulo, 12, '/F2', true);
              (grupo.itens || []).forEach(function(item) {
                if (item.nome) escrever(item.nome, 10, '/F2', true);
                escrever(item.texto, 10, '/F1', false);
                cursor -= 6;
              });
            });
            if (modelo.frequencia) {
              cursor -= 4;
              escrever(modelo.frequencia, 10, '/F2', true);
            }
            paginas.push(comandos.join('\n'));
            return montarArquivoPdf(paginas, modelo.logo);
          }

          novaPagina(true);
          for (var linha = cabecalho; linha < modelo.linhas.length; linha++) {
            if (cursor - (alturas[linha] || 0) < margem) novaPagina(false);
            var topo = cursor;
            modelo.linhas[linha].forEach(function(celula) { desenharCelula(comandos, celula, topo); });
            cursor -= alturas[linha] || 0;
          }
          if (!modelo.linhas.length) {
            comandos.push(comandoTexto(margem, cursor - 12, '/F1', 11, 'O professor ainda não lançou as notas deste ano.'));
          }
          paginas.push(comandos.join('\n'));

          return montarArquivoPdf(paginas, modelo.logo);
        }

        function montarArquivoPdf(streams, logo) {
          var objetos = [];
          function adicionar(corpo) {
            objetos.push(corpo);
            return objetos.length;
          }

          var idFonte = adicionar('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>');
          var idFonteNegrito = adicionar('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>');
          var idInfo = adicionar('<< /Title (Boletim Escolar) /Producer (i-Diario) >>');
          var idImagem = null;
          if (logo && logo.hex) {
            idImagem = adicionar('<< /Type /XObject /Subtype /Image /Width ' + logo.width + ' /Height ' + logo.height + ' /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter [/ASCIIHexDecode /DCTDecode] /Length ' + logo.hex.length + ' >>\nstream\n' + logo.hex + '\nendstream');
          }
          var recursosImagem = idImagem ? ' /XObject << /Im1 ' + idImagem + ' 0 R >>' : '';
          var idsConteudo = streams.map(function(stream) {
            return adicionar('<< /Length ' + stream.length + ' >>\nstream\n' + stream + '\nendstream');
          });
          var idsPagina = idsConteudo.map(function(idConteudo) {
            return adicionar('<< /Type /Page /Parent PAGINAS /MediaBox [0 0 595.28 841.89] /Contents ' + idConteudo + ' 0 R /Resources << /Font << /F1 ' + idFonte + ' 0 R /F2 ' + idFonteNegrito + ' 0 R >>' + recursosImagem + ' >> >>');
          });
          var idPaginas = adicionar('<< /Type /Pages /Count ' + idsPagina.length + ' /Kids [' + idsPagina.map(function(id) { return id + ' 0 R'; }).join(' ') + '] >>');
          var idCatalogo = adicionar('<< /Type /Catalog /Pages ' + idPaginas + ' 0 R >>');
          idsPagina.forEach(function(id) {
            objetos[id - 1] = objetos[id - 1].replace('PAGINAS', idPaginas + ' 0 R');
          });

          var saida = '%PDF-1.4\n%\xE2\xE3\xCF\xD3\n';
          var offsets = [0];
          objetos.forEach(function(corpo, indice) {
            offsets.push(saida.length);
            saida += (indice + 1) + ' 0 obj\n' + corpo + '\nendobj\n';
          });
          var xref = saida.length;
          saida += 'xref\n0 ' + (objetos.length + 1) + '\n';
          saida += '0000000000 65535 f \n';
          for (var i = 1; i <= objetos.length; i++) {
            var posicao = String(offsets[i]);
            saida += '0000000000'.substring(posicao.length) + posicao + ' 00000 n \n';
          }
          saida += 'trailer << /Size ' + (objetos.length + 1) + ' /Root ' + idCatalogo + ' 0 R /Info ' + idInfo + ' 0 R >>\n';
          saida += 'startxref\n' + xref + '\n%%EOF';

          var bytes = new Uint8Array(saida.length);
          for (var j = 0; j < saida.length; j++) bytes[j] = saida.charCodeAt(j) & 255;
          return bytes;
        }

        (function() {
          var origem = document.getElementById('boletim-avaliacoes-dados');
          var modal = document.getElementById('boletim-modal');
          if (!origem || !modal) return;

          var dados = JSON.parse(origem.textContent || '{}');
          var titulo = document.getElementById('boletim-modal-titulo');
          var etapa = document.getElementById('boletim-modal-etapa');
          var corpo = document.getElementById('boletim-modal-corpo');

          function escapar(texto) {
            return String(texto || '').replace(/[&<>"']/g, function(caractere) {
              return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[caractere];
            });
          }

          function fechar() {
            modal.hidden = true;
          }

          function abrir(chave) {
            var item = dados[chave];
            if (!item) return;

            titulo.textContent = item.discipline || 'Disciplina';
            etapa.textContent = (item.step || 'Etapa') + (item.score ? ' • Nota ' + item.score : '');

            var html = '';
            if (item.scale_note) {
              html += '<p class="boletim-modal-escala">' + escapar(item.scale_note) + '</p>';
            }
            if (item.details && item.details.length) {
              html += '<ul class="boletim-modal-lista">';
              item.details.forEach(function(detalhe) {
                html += '<li><strong>' + escapar(detalhe.label) + '</strong>';
                if (detalhe.score) html += '<span class="boletim-modal-nota">' + escapar(detalhe.score) + '</span>';
                html += '</li>';
              });
              html += '</ul>';
            } else {
              html += '<p>Ainda não há avaliações lançadas neste bimestre.</p>';
            }
            if (item.opinion) {
              html += '<div class="boletim-parecer"><strong>O que o professor escreveu</strong><p>' + escapar(item.opinion) + '</p></div>';
            }
            if (item.year_opinion) {
              html += '<div class="boletim-parecer"><strong>Parecer do ano</strong><p>' + escapar(item.year_opinion) + '</p></div>';
            }
            corpo.innerHTML = html;
            modal.hidden = false;
          }

          document.querySelector('.boletim').addEventListener('click', function(evento) {
            var botao = evento.target.closest('.boletim-nota');
            if (!botao) return;
            abrir(botao.getAttribute('data-avaliacao'));
          });

          modal.addEventListener('click', function(evento) {
            if (evento.target.getAttribute('data-fechar') === 'true') fechar();
          });

          document.addEventListener('keydown', function(evento) {
            if (evento.key === 'Escape') fechar();
          });
        })();
      </script>
    <% end %>
  <% end %>
</section>
