<% content_for :js do %>
  <%= javascript_include_tag 'list-contents' %>
  <%= javascript_include_tag 'views/discipline_content_records/form' %>
<% end %>

<%= simple_form_for @discipline_content_record, url: polymorphic_path(@discipline_content_record, params.permit(:modal).to_h), html: { class: 'smart-form' } do |f| %>
  <%= f.error_notification %>

  <%= f.simple_fields_for :content_record, @discipline_content_record.content_record.localized do |content_record| %>
    <%= content_record.hidden_field :id %>

    <fieldset>
      <div class="row">
        <%= content_record.input :unity_id, as: :hidden, input_html: { value: current_user.current_unity_id } %>
        <%= content_record.input :classroom_id, as: :hidden, input_html: { value: current_user.current_classroom_id } %>
        
        <% if params[:modal] == 'true' %>
          <%= f.input :discipline_id, as: :hidden, input_html: { value: @discipline_content_record.discipline_id } %>
        <% else %>
          <div class="col col-sm-4">
            <%= f.association :discipline, as: :select2, elements: @disciplines, user: current_user,
                record: f.object, classroom_id: @discipline_content_record.content_record.classroom_id,
                readonly: ['show', 'edit'].include?(action_name) %>
          </div>
        <% end %>
      </div>

      <div class="row">
        <% if params[:modal] == 'true' %>
          <%= content_record.input :record_date, as: :hidden, input_html: {value: @discipline_content_record.content_record.record_date} %>
        <% else %>
          <div class="col col-sm-4">
            <%= content_record.input :record_date, as: :date %>
          </div>
        <% end %>

        <% if @allow_class_number %>
          <div class="col col-sm-4">
            <% isDisabled = ['new', 'create', 'edit', 'update'].include?(action_name) ? false : true %>
            <%= f.input :class_number, as: :select2, multiple: false,
                                     elements: number_of_classes_elements(@number_of_classes),
                                     placeholder: 'Selecione a quantidade de aulas',
                                     disabled: isDisabled,
                                     input_html: { value: @class_number_qtd } %>
          </div>
        <% else %>
            <%= f.input :class_number, as: :hidden, input_html: { value: @class_number_qtd } %>
        <% end %>
      </div>

    </fieldset>
    <fieldset>
      <legend><%= @discipline_content_record.class.human_attribute_name(:contents) %></legend>
      <% if content_record.object.errors[:contents].any? %>
        <div class="alert alert-danger fade in">
          <i class="fa-fw fa fa-times"></i>
          <%= content_record.object.errors[:contents].first %>
        </div>
      <% end %>
        <div style="max-height: 300px;overflow-y: auto;">
          <ul class="list-group checked-list-box" id="contents-list">

            <% contents.each do |content| %>
              <% 
                # Para um registro novo, não deve haver conteúdos salvos
                # Só marca como checked se o registro estiver persistido E o conteúdo estiver realmente salvo
                content_checked = @discipline_content_record.persisted? && 
                                  @discipline_content_record.content_record.persisted? && 
                                  content.id.in?(@discipline_content_record.content_record.contents.pluck(:id))
              %>
              <li class="list-group-item manual" style="display: flex;" id="content_record_<%= content.id %>">
                <%= check_box_tag("discipline_content_record[content_record_attributes][content_ids][]",
                    content.id, content_checked,
                    hidden: true, 'data-content_description': content.to_s ) %>
                <span style="margin-left: 5px;display: block;width: calc(100% - 85px);"><%= content %></span>
                <% if content.is_editable %>
                  <div style="width: 80px;">
                    <a class="btn btn-success" onclick="editContent('content_record_<%= content.id %>')">
                      <i class="fa fa-pencil"></i>
                    </a>
                    <a class="btn btn-danger" onclick="removeContent('content_record_<%= content.id %>')">
                      <i class="fa fa-trash"></i>
                    </a>
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
        <div class="row textarea contents-select2-container">
          <div class="col col-sm-12">
            <% translation = Translator.t('activerecord.attributes.discipline_content_record.contents') %>
            <%= content_record.input :contents_tags,
                as: :string,
                label: "Adicionar #{translation}",
                input_html: {
                  class: 'select2-content-tags-ajax',
                  value: '',
                  data: {
                    url: contents_path,
                    data: content_record.object.contents_tags,
                    :'filter-by-description' => 1
                  }
                }
            %>
          </div>
        </div>

        <% if show_objectives %>
          <div class="row textarea">
            <div class="col col-sm-12">
              <legend style="margin-bottom: 10px;">
                <span>Objetivos</span>
              </legend>
              <% if f.object.errors[:'content_record.objectives'].any? %>
                <div class="alert alert-danger fade in">
                  <i class="fa-fw fa fa-times"></i>
                  <%= f.object.errors[:'content_record.objectives'].first %>
                </div>
              <% end %>

              <div style="max-height: 300px;overflow-y: auto; margin-top: 10px;">
                <ul class="list-group checked-list-box" id="objectives-list">
                <% objectives.each do |objective| %>
                  <li class="list-group-item manual" style="display: flex;" id="objective_<%= objective.id %>">
                    <%= check_box_tag("discipline_content_record[content_record_attributes][objective_ids][]",
                      objective.id, objective.id.in?(@discipline_content_record.objectives.collect(&:id)),
                      hidden: true, 'data-objective_description': objective.to_s ) %>
                    <span style="margin-left: 5px;display: block;width: calc(100% - 85px);"><%= objective %></span>
                    <% if objective.is_editable %>
                      <div style="width: 80px;">
                        <a class="btn btn-danger" onclick="removeObjective('objective_<%= objective.id %>')">
                          <i class="fa fa-trash"></i>
                        </a>
                      </div>
                    <% end %>
                  </li>
                <% end %>
                </ul>
              </div>
              <% if !action_name.eql?('show') %>
                <div class="row textarea">
                  <div class="col col-sm-12 objectives-select2-container">
                    <%= content_record.input :objectives_tags,
                        as: :string,
                        label: "Adicionar Habilidades",
                        input_html: {
                          class: 'select2-content-tags-ajax',
                          value: '',
                          data: {
                            url: objectives_path,
                            data: []
                          }
                        }
                    %>
                  </div>
                </div>
              <% end %>

            </div>
          </div>
        <% end %>

        <div class="row">
          <div class="col col-sm-12">
            <%= content_record.input :daily_activities_record, as: :text,
                  required: f.object.decorator.daily_activities_required? %>
          </div>
        </div>
    </fieldset>    
  <% end %>

  <footer>
    <%= f.submit t('views.form.save'), class: 'btn btn-primary pull-right', data: { disable_with: 'Salvando...'} %>

    <% unless params[:modal] == 'true' %>
      <%= link_to t('views.form.back'), discipline_content_records_path, class: 'btn btn-default pull-left' %>
    <% end %>

    <% if @discipline_content_record.persisted? %>
      <%= link_to t('views.form.history'),
            history_discipline_content_record_path(@discipline_content_record),
            class: 'btn btn-info' %>
    <% end %>
  </footer>
<% end %>
