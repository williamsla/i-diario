<% content_for :js do %>
  <%= javascript_include_tag 'views/daily_frequencies/new' %>
<% end %>

<div class="widget-body no-padding">
  <%= simple_form_for @daily_frequency, url: daily_frequencies_path, method: :post,
        html: {
          class: 'smart-form',
          id: 'daily-frequency-new-form',
          data: {
            disciplines_for_date_url: disciplines_for_frequency_date_daily_frequencies_path,
            schedule_for_date_url: schedule_for_frequency_date_daily_frequencies_path,
            fetch_frequency_type_url: fetch_frequency_type_daily_frequencies_path,
            class_numbers_by_discipline_url: class_numbers_by_discipline_daily_frequencies_path
          }
        } do |f| %>
    <%= f.hidden_field :period, value: @period %>
    <%= f.hidden_field :unity_id %>
    <%= f.hidden_field :classroom_id %>
    <div class="alert alert-danger hidden" id="exam-rule-not-found-alert">
      <i class="fa fa-exclamation-circle fa-fw"></i>
      <%= t('.exam_rule_not_found') %>
    </div>
    <div class="alert alert-warning <%= @frequency_date_message.blank? ? 'hidden' : '' %>" id="disciplines-empty-alert">
      <i class="fa fa-info-circle fa-fw"></i>
      <span id="disciplines-empty-message"><%= @frequency_date_message %></span>
    </div>
    <%= f.error_notification %>

    <fieldset style="padding: 2px; padding-bottom: 15px;">
      <div class="row">
        <div class="col col-sm-12">
          <small class="text-muted">
            Ano letivo: <strong><%= (defined?(current_school_year) && current_school_year) || (defined?(current_school_calendar) && current_school_calendar&.year) || Time.zone.today.year %></strong>
            | Escola: <strong><%= @daily_frequency.unity %></strong>
            | Turma: <strong><%= @daily_frequency.classroom %></strong>
          </small>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <div class="row">
        <div class="col col-sm-4">
          <%= f.input :frequency_date %>
          <p class="help-block text-warning frequency-date-hint <%= @frequency_date_message.blank? ? 'hidden' : '' %>" id="frequency-date-hint">
            <%= @frequency_date_message %>
          </p>
        </div>
      </div>
      <div class="row">
        <div class="col col-sm-4 discipline_field">
          <div class="control-group required daily_frequency_discipline <%= @error_on_discipline ? 'error' : '' %>">
            <%= f.input :discipline_id, as: :select2, elements: @disciplines, user: current_user,
                        classroom_id: @daily_frequency.classroom_id,
                        required: true %>
          </div>
        </div>
        <div class="col col-sm-4 turno_field hidden">
          <div class="control-group required daily_frequency_turno">
            <label class="select2 required control-label" for="daily_frequency_turno">Turno <abbr title="obrigatório">*</abbr></label>
            <%= hidden_field_tag :turno, '',
                  id: 'daily_frequency_turno',
                  class: 'form-control select2-turno',
                  data: {
                    placeholder: 'Selecione o turno'
                  } %>
          </div>
        </div>
        <div class="col col-sm-4 class_numbers_field">
          <div class="control-group required daily_frequency_class_numbers <%= @error_on_class_numbers ? 'error' : '' %>">
            <label class="select2 required control-label" for="daily_frequency_class_numbers">Informe o número exato da aula (1ª, 2ª, 3ª...) <abbr title="obrigatório">*</abbr></label>
            <%= hidden_field_tag :class_numbers,
                  @class_numbers.to_s,
                  class: 'form-control select2',
                  data:{
                    multiple: true,
                    elements: number_of_classes_elements(@number_of_classes),
                    placeholder: 'Ex: 2 (somente a segunda aula)'
                  } %>
          </div>
        </div>
      </div>

    </fieldset>

    <footer>
      <%= f.submit 'Carregar', class: "btn btn-primary #{'disabled' if @frequency_date_message.present?}" %>
    </footer>
  <% end %>
</div>
