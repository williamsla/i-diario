<div class="widget-body no-padding">
  <div class="alert alert-info" style="margin: 15px;">
    <%= t('.help', year: @report.year) %>
  </div>

  <%= form_tag user_access_reports_path, method: :get, class: 'smart-form' do %>
    <fieldset>
      <div class="row">
        <section class="col col-sm-6">
          <label class="label" for="role_id"><%= t('.role') %></label>
          <label class="select">
            <%= select_tag :role_id,
                  options_from_collection_for_select(@roles, :id, :name, @report.role&.id),
                  include_blank: t('.role_prompt') %>
            <i></i>
          </label>
        </section>
      </div>
    </fieldset>
    <footer>
      <button type="submit" class="btn btn-primary"><%= t('.submit') %></button>
    </footer>
  <% end %>

  <% if @report.role %>
    <div class="table-responsive" style="padding: 0 15px 15px;">
      <table class="table table-striped table-bordered table-condensed">
        <thead>
          <tr>
            <th><%= t('.school') %></th>
            <th><%= t('.users') %></th>
          </tr>
        </thead>
        <tbody>
          <% if @report.rows.empty? %>
            <tr>
              <td colspan="2"><%= t('.empty') %></td>
            </tr>
          <% else %>
            <% @report.rows.each do |row| %>
              <tr class="<%= 'info' if @report.chart_for?(row) %>">
                <td>
                  <%= link_to row.name, user_access_reports_path(role_id: @report.role.id, unity_id: row.unity_id || 'none') %>
                </td>
                <td><%= number_with_delimiter(row.count) %></td>
              </tr>
            <% end %>
          <% end %>
          <tr class="<%= 'info' if @report.chart_for_all? %>">
            <th>
              <%= link_to t('.total'), user_access_reports_path(role_id: @report.role.id, unity_id: 'all') %>
            </th>
            <th><%= number_with_delimiter(@report.total) %></th>
          </tr>
        </tbody>
      </table>
    </div>

    <% if @report.chart_school_name %>
      <div class="modal fade" id="user-access-chart-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <button type="button" class="close" data-dismiss="modal">
                <span aria-hidden="true">&times;</span>
                <span class="sr-only"><%= t('.close') %></span>
              </button>
              <h4 class="modal-title"><%= t('.chart_title', school: @report.chart_school_name) %></h4>
            </div>
            <div class="modal-body">
              <p class="text-muted"><%= t('.chart_help', year: @report.year, previous_year: @report.year - 1) %></p>
              <% accesses = @report.monthly_accesses %>
              <% previous = @report.previous_monthly_accesses %>
              <% if accesses.any? %>
                <div style="position: relative; height: 320px;">
                  <canvas id="user-access-chart"></canvas>
                </div>
              <% else %>
                <p><%= t('.chart_empty') %></p>
              <% end %>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-default" data-dismiss="modal"><%= t('.close') %></button>
            </div>
          </div>
        </div>
      </div>
      <% if accesses&.any? %>
        <% content_for :js do %>
          <script>
            var userAccessChartModal = $('#user-access-chart-modal');
            userAccessChartModal.on('shown.bs.modal', function () {
              if (userAccessChartModal.data('chart-ready')) return;
              userAccessChartModal.data('chart-ready', true);
              new Chart(document.getElementById('user-access-chart').getContext('2d'), {
                type: 'line',
                data: {
                  labels: <%= raw @report.month_labels.to_json %>,
                  datasets: [{
                    label: '<%= j t('.chart_series', year: @report.year) %>',
                    data: <%= raw accesses.map(&:count).to_json %>,
                    borderColor: '#3276b1',
                    backgroundColor: 'rgba(50, 118, 177, 0.15)',
                    fill: true,
                    lineTension: 0.15,
                    pointRadius: 3
                  }, {
                    label: '<%= j t('.previous_chart_series', year: @report.year - 1) %>',
                    data: <%= raw previous.map(&:count).to_json %>,
                    borderColor: '#f0ad4e',
                    backgroundColor: 'transparent',
                    borderDash: [6, 4],
                    fill: false,
                    lineTension: 0.15,
                    pointRadius: 3
                  }]
                },
                options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  legend: { display: true },
                  scales: {
                    yAxes: [{
                      ticks: { beginAtZero: true, precision: 0 }
                    }]
                  }
                }
              });
            });
            userAccessChartModal.modal('show');
          </script>
        <% end %>
      <% else %>
        <% content_for :js do %>
          <script>
            $('#user-access-chart-modal').modal('show');
          </script>
        <% end %>
      <% end %>
    <% end %>
  <% elsif params[:role_id].present? %>
    <div class="alert alert-warning" style="margin: 15px;">
      <%= t('.missing_role') %>
    </div>
  <% else %>
    <div class="alert alert-info" style="margin: 15px;">
      <%= t('.choose_role') %>
    </div>
  <% end %>
</div>
