.pedagogical-modal {
  align-items: center;
  background: rgba(15, 23, 42, 0.55);
  bottom: 0;
  display: flex;
  justify-content: center;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 9999;
}

.pedagogical-modal__dialog {
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
  max-height: 92vh;
  overflow: auto;
  padding: 0;
  width: min(960px, 94vw);
}

.pedagogical-modal__dialog--wide {
  width: min(1100px, 96vw);
}

.pedagogical-modal__header {
  align-items: flex-start;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  justify-content: space-between;
  padding: 18px 22px 14px;
}

.pedagogical-modal__title {
  color: #0f172a;
  font-size: 20px;
  font-weight: 600;
  margin: 0 0 4px;
}

.pedagogical-modal__summary {
  color: #64748b;
  font-size: 13px;
  margin: 0;
}

.pedagogical-modal__close {
  background: none;
  border: 0;
  color: #94a3b8;
  cursor: pointer;
  font-size: 34px;
  line-height: 1;
  padding: 0 4px;
}

.pedagogical-modal__close:hover {
  color: #475569;
}

.pedagogical-modal__body {
  padding: 18px 22px 22px;
}

.pedagogical-modal__loading {
  color: #64748b;
  margin: 30px 0;
  text-align: center;
}

.tag-cloud-card {
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 48%);
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  height: 100%;
  min-height: 360px;
  padding: 14px;
}

.tag-cloud-card__header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
}

.tag-cloud-card__header h3 {
  color: #334155;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.02em;
  margin: 0;
  text-transform: uppercase;
}

.tag-cloud-card__count {
  background: #e2e8f0;
  border-radius: 999px;
  color: #475569;
  font-size: 12px;
  font-weight: 600;
  min-width: 28px;
  padding: 2px 8px;
  text-align: center;
}

.pedagogical-tag-cloud {
  align-content: flex-start;
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: flex-start;
  min-height: 280px;
}

.pedagogical-tag-cloud__item {
  align-items: center;
  background: #eff6ff;
  border: 1px solid #dbeafe;
  border-radius: 999px;
  color: #1d4ed8;
  display: inline-flex;
  gap: 8px;
  line-height: 1.2;
  max-width: 100%;
  padding: 6px 10px 6px 12px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.pedagogical-tag-cloud__item:hover {
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
  transform: translateY(-1px);
}

.pedagogical-tag-cloud__label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pedagogical-tag-cloud__badge {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 999px;
  color: #334155;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 7px;
}

.pedagogical-tag-cloud__item--1 {
  background: #f8fafc;
  border-color: #e2e8f0;
  color: #64748b;
  font-size: 12px;
}

.pedagogical-tag-cloud__item--2 {
  background: #f1f5f9;
  border-color: #e2e8f0;
  color: #475569;
  font-size: 13px;
}

.pedagogical-tag-cloud__item--3 {
  background: #eff6ff;
  border-color: #bfdbfe;
  color: #2563eb;
  font-size: 14px;
}

.pedagogical-tag-cloud__item--4 {
  background: #dbeafe;
  border-color: #93c5fd;
  color: #1d4ed8;
  font-size: 15px;
  font-weight: 600;
}

.pedagogical-tag-cloud__item--5 {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  border-color: #1d4ed8;
  color: #fff;
  font-size: 16px;
  font-weight: 700;
}

.pedagogical-tag-cloud__item--5 .pedagogical-tag-cloud__badge {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.pedagogical-tag-cloud__empty {
  align-items: center;
  color: #94a3b8;
  display: flex;
  flex-direction: column;
  gap: 8px;
  justify-content: center;
  min-height: 260px;
  text-align: center;
  width: 100%;
}

.pedagogical-tag-cloud__empty i {
  font-size: 28px;
}

.pedagogical-tag-cloud__empty p {
  margin: 0;
}

