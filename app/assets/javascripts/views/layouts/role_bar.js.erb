$(function() {
  'use strict';

  const breakpoint = 1365;

  const $body = $('html, body');
  const $loginInfo = $('#user-info-selector');
  const $roleBar = $('#current-role-selector');
  const $closeBar = $('.role-cancel');

  let documentWidth = window.innerWidth;

  function isProfileIncomplete() {
    return window.state && window.state.profile_complete === false;
  }

  function requiresModalLayout() {
    return isModal() || isProfileIncomplete();
  }

  function isModal() {
    const size = window.innerWidth;

    return size < breakpoint;
  }

  function openRoleBar() {
    if (isProfileIncomplete()) {
      $('body').addClass('profile-selector-required');
    }

    $roleBar.show();
    $body.css({ overflow: 'hidden' });
  }

  function closeRoleBar() {
    $roleBar.hide();
    $body.css({ overflow: 'auto' });

    if (!isProfileIncomplete()) {
      $('body').removeClass('profile-selector-required');
    }
  }

  function syncRoleBarVisibility() {
    if (requiresModalLayout()) {
      if (isProfileIncomplete()) {
        $('body').addClass('profile-selector-required');
      }

      if (!$roleBar.is(':visible')) {
        $roleBar.hide();
      }
    } else {
      $('body').removeClass('profile-selector-required');
      $roleBar.show();
      $body.css({ overflow: 'auto' });
    }
  }

  function openProfileSelectorIfNeeded() {
    if (!isProfileIncomplete()) {
      return;
    }

    openRoleBar();
  }

  $loginInfo.click(function (e) {
    if ($roleBar.is(':hidden')) {
      openRoleBar();
    }

    e.preventDefault();
  });

  $closeBar.click(function (e) {
    if ($roleBar.is(':visible')) {
      closeRoleBar();
    }

    e.preventDefault();
  });

  $(window).resize(function () {
    let currDocumentWidth = window.innerWidth;

    if (currDocumentWidth === documentWidth) {
      return true;
    }

    syncRoleBarVisibility();
    documentWidth = currDocumentWidth;
  });

  document.addEventListener('profile-selector:open', openProfileSelectorIfNeeded);

  if (isProfileIncomplete()) {
    $('body').addClass('profile-selector-required');
    $roleBar.hide();
  } else if (isModal()) {
    $roleBar.hide();
  }

  setTimeout(openProfileSelectorIfNeeded, 300);
});
