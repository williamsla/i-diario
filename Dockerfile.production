# Imagem de produção (multi-stage: build + runtime).
# Build (recomendado): DOCKER_BUILDKIT=1 docker build -f Dockerfile.production -t idiario:prod .
#   ou: ./docker/build-push-registry.sh
# Runtime: monte config/secrets.yml (obrigatório). database.yml vem do sample na imagem (usa ENV).
# ENTRYPOINT: roda db:migrate quando RUN_DB_MIGRATE_ON_START!=0, depois CMD (Puma por padrão).
#
# Deploy rápido: assets são pré-compilados só quando Gemfile, yarn.lock ou arquivos de asset mudam.
# Mudanças só em Ruby reutilizam a camada de assets:precompile (~30 min evitados).

# syntax=docker/dockerfile:1

FROM ruby:2.4.10-slim-buster AS builder

# Buster está arquivado: mirrors ativos não publicam mais Release válido.
RUN set -eux \
  && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99archive \
  && sed -i \
    -e 's|deb.debian.org/debian|archive.debian.org/debian|g' \
    -e 's|security.debian.org/debian-security|archive.debian.org/debian-security|g' \
    /etc/apt/sources.list

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    curl \
    ca-certificates \
    nodejs \
    npm \
    libxslt-dev \
    libxml2-dev \
    zlib1g-dev \
    shared-mime-info \
  && npm i -g yarn@1 \
  && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8 \
    BUNDLE_SILENCE_ROOT_WARNING=1 \
    GEM_HOME=/usr/local/bundle \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_APP_CONFIG=/usr/local/bundle

WORKDIR /app

RUN gem install bundler:1.17.3

COPY Gemfile Gemfile.lock ./

RUN bundle install --without development test --jobs 4 --retry 3

COPY package.json yarn.lock ./

# npm i -g yarn no Buster deixa yarn.js sem +x → "Permission denied" (exit 126).
RUN set -eux \
  && yarn_bin="$(command -v yarn)" \
  && chmod +x "$yarn_bin" \
  && chmod +x "$(readlink -f "$yarn_bin")" \
  && if ! node -v >/dev/null 2>&1; then ln -sf "$(command -v nodejs)" /usr/local/bin/node; fi \
  && yarn install --frozen-lockfile --network-timeout 100000

# Rails boota o app inteiro no assets:precompile (controllers, models, etc.).
# Gemfile/yarn.lock em camadas anteriores continuam em cache quando só o código Ruby muda.
COPY Rakefile config.ru babel.config.js postcss.config.js ./
COPY bin bin/
COPY config config/
COPY app app/
COPY lib lib/
COPY vendor/assets vendor/assets/
COPY public public/
COPY docker/secrets.build.yml docker/secrets.build.yml

RUN cp config/database.sample.yml config/database.yml \
  && cp docker/secrets.build.yml config/secrets.yml

ENV RAILS_ENV=production \
    NODE_ENV=production \
    PRECOMPILING_ASSETS=1 \
    EXECJS_RUNTIME=Node

RUN --mount=type=cache,target=/app/tmp/cache/webpacker \
    --mount=type=cache,target=/usr/local/share/.cache/yarn \
    bundle exec rake assets:precompile

COPY . .

RUN rm -f config/secrets.yml \
  && rm -f config/database.yml \
  && rm -rf node_modules /usr/local/bundle/cache

# --- runtime ---

FROM ruby:2.4.10-slim-buster

RUN set -eux \
  && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99archive \
  && sed -i \
    -e 's|deb.debian.org/debian|archive.debian.org/debian|g' \
    -e 's|security.debian.org/debian-security|archive.debian.org/debian-security|g' \
    /etc/apt/sources.list

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    curl \
    nodejs \
    libpq5 \
    shared-mime-info \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8 \
    RAILS_ENV=production \
    BUNDLE_SILENCE_ROOT_WARNING=1 \
    GEM_HOME=/usr/local/bundle \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_APP_CONFIG=/usr/local/bundle \
    RAILS_LOG_TO_STDOUT=1 \
    RAILS_SERVE_STATIC_FILES=1

WORKDIR /app

RUN gem install bundler:1.17.3

COPY --from=builder /usr/local/bundle /usr/local/bundle
COPY --from=builder /app /app

RUN cp config/database.sample.yml config/database.yml

COPY docker/docker-entrypoint-production.sh /usr/local/bin/docker-entrypoint-production.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-production.sh

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint-production.sh"]
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
